    public static long getExpectedMinBytes(String modelName) {
        if (modelName == null) return 100L * 1024L * 1024L;
        String lower = modelName.toLowerCase();
        if (lower.contains("0.5b") || lower.contains("0.6b")) return 100L * 1024L * 1024L;
        if (lower.contains("1.5b") || lower.contains("1.7b") || lower.contains("2b") || lower.contains("3b") || lower.contains("4b")) return 500L * 1024L * 1024L;
        if (lower.contains("7b") || lower.contains("8b")) return 2000L * 1024L * 1024L;
        return 100L * 1024L * 1024L;
    }

    public static boolean isValidGGUFFile(File f, String modelName) {
        if (f == null) return false;
        try {
            if (!f.exists()) return false;
            long len = f.length();
            if (len < getExpectedMinBytes(modelName)) return false;
            try (java.io.FileInputStream fis = new java.io.FileInputStream(f)) {
                byte[] magic = new byte[4];
                int n = fis.read(magic);
                if (n == 4 && magic[0] == 'G' && magic[1] == 'G' && magic[2] == 'U' && magic[3] == 'F') {
                    return true;
                }
            } catch (Exception ignored) {}
        } catch (Throwable ignored) {}
        return false;
    }
