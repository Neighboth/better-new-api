    // Read server, node and secret from one SharedPreferences snapshot: a
    // concurrent re-pair must never send a new secret to the previous server.
    public static String snapshotString(Map<String, ?> snapshot, String key) {
        Object value = snapshot.get(key);
        return value instanceof String ? (String) value : "";
    }

    /**
     * Reads a text of the settings, a value of another type is ignored.
     */
    public static String normalizeServerUrl(String url) {
        if (url == null) return "";
        url = url.trim();
        while (url.endsWith("/")) url = url.substring(0, url.length() - 1);
        boolean isEmu = Build.FINGERPRINT.startsWith("generic")
            || Build.FINGERPRINT.startsWith("unknown")
            || Build.MODEL.contains("google_sdk")
            || Build.MODEL.contains("Emulator")
            || Build.MODEL.contains("Android SDK built for x86")
            || Build.HARDWARE.contains("goldfish")
            || Build.HARDWARE.contains("ranchu");
        if (isEmu) {
            url = url.replace("://127.0.0.1", "://10.0.2.2").replace("://localhost", "://10.0.2.2");
        }
        return url;
    }

    // HTTPS protects pairing codes and worker secrets. Plain HTTP is limited to
    // loopback (or the Android emulator's explicit host loopback alias).
    public static boolean isSecureServerURL(String value) {
        try {
            URL u = new URL(value);
            if (u.getUserInfo() != null || u.getQuery() != null || u.getRef() != null || u.getHost().isEmpty()) return false;
            if ("https".equalsIgnoreCase(u.getProtocol())) return true;
            if (!"http".equalsIgnoreCase(u.getProtocol())) return false;
            String host = u.getHost();
            if ("localhost".equalsIgnoreCase(host) || "127.0.0.1".equals(host) || "[::1]".equals(host)) return true;
            boolean emulator = Build.FINGERPRINT.startsWith("generic") || Build.FINGERPRINT.startsWith("unknown")
                || Build.HARDWARE.contains("goldfish") || Build.HARDWARE.contains("ranchu");
            return emulator && "10.0.2.2".equals(host);
        } catch (Exception ignored) { return false; }
    }

    /**
     * Reads a text of the settings, a value of another type is ignored.
     */
    public static String stringPref(SharedPreferences sp, String key, String fallback) {
        if (sp == null) return fallback;
        try {
            String val = sp.getString(key, fallback);
            if ("server_url".equals(key) && val != null) {
                return normalizeServerUrl(val);
            }
            return val;
        } catch (ClassCastException e) {
            return fallback;
        }
    }

    /**
     * Installs the handler for the failures of the threads of the worker.
     *
     * Without a handler of its own, a failure of a thread ends the whole
     * application. The failure is reported to the coordinator instead, the
     * worker keeps running.
     */
    /**
     * A failure of a background thread of the worker must not end the whole
     * application, a failure of the main thread must not leave the application
     * as a frozen shell that never opens again.
     *
     * The handler reports every failure. A dead main thread ends the process
     * after the interface is started again, a dead background thread is only
     * reported and the loops of the worker restart their own work with the
     * next tick.
     */
    private void installWorkerCrashHandler() {
        try {
            Thread.setDefaultUncaughtExceptionHandler(new Thread.UncaughtExceptionHandler() {
                @Override
                public void uncaughtException(Thread t, Throwable e) {
                    try {
                        android.util.Log.e("BYOG_CRASH", "Worker thread " + t.getName() + " failed", e);
                        SharedPreferences sp = getSharedPreferences("byog_prefs", MODE_PRIVATE);
                        if (sp != null) {
                            // A worker that dies again and again ends in a crash
                            // loop of the whole application: the streak switches
                            // the worker off (safe mode) so the interface opens
                            // again on the next start (Honor Pad 10).
                            long now = System.currentTimeMillis();
                            long previous = longPref(sp, "worker_last_crash_time", 0L);
                            int streak = (now - previous <= 120000L) ? intPref(sp, "worker_crash_streak", 0) + 1 : 1;
                            SharedPreferences.Editor ed = sp.edit()
                                    .putString("last_crash", describe(e))
                                    .putLong("last_crash_at", now)
                                    .putLong("worker_last_crash_time", now)
                                    .putInt("worker_crash_streak", streak);
                            if (streak >= 2) ed.putBoolean("safe_mode", true);
                            ed.commit();
                        }
                        reportCrash("ERR_WORKER_THREAD", describe(e), "");
                    } catch (Throwable ignored) {}

                    boolean isMainThread = false;
                    try {
                        isMainThread = (t == android.os.Looper.getMainLooper().getThread());
                    } catch (Throwable ignored) {}
                    if (!isMainThread) {
                        return;
                    }
                    // The main thread is dead: the interface of the application
                    // never opens again while the process runs, the process is
                    // ended and the interface is started again.
                    // Prevent infinite restart crash loop
                    try {
                        android.os.Process.killProcess(android.os.Process.myPid());
                    } catch (Throwable ignored) {}
                    try {
                        System.exit(10);
                    } catch (Throwable ignored) {}
                }
            });
        } catch (Throwable ignored) {}
    }

    /**
     * Handles the removal of the device from the network. The pairing is dropped, the
     * interface asks for a new pairing code and the device stops the worker.
     */
    private void handleDeviceRemoved() {
        try {
            SharedPreferences sp = getSharedPreferences("byog_prefs", MODE_PRIVATE);
            sp.edit()
                    .putBoolean("is_paired", false)
                    .putString("node_id", "").putString("worker_secret", "")
                    .putString("pairing_code", "")
                    .putString("device_removed_message", "Cihaz kaldırıldı")
                    .apply();

            try {
                JSONObject state = new JSONObject();
                state.put("is_paired", false);
                state.put("device_removed", true);
                state.put("message", "Cihaz kaldırıldı");
                Intent bIntent = new Intent("org.byog.worker.STATE_CHANGED");
                bIntent.putExtra("state", state.toString());
                bIntent.setPackage(getPackageName());
                sendBroadcast(bIntent);
            } catch (Exception ignored) {}

            String appName = stringPref(sp, "app_name", "{app_name}");
            Notification removed = buildNotification(appName, "Cihaz kaldırıldı - yeniden eşleştirme gerekiyor");
            NotificationManager nm = (NotificationManager) getSystemService(Context.NOTIFICATION_SERVICE);
            if (nm != null) nm.notify(NOTIF_ID, removed);
        } catch (Exception ignored) {}
        stopSelf();
    }

    /**
     * Publishes the current worker state to the local UI immediately.
     */
    private void broadcastCurrentState() {
        try {
            SharedPreferences sp = getSharedPreferences("byog_prefs", MODE_PRIVATE);
            if (sp == null) return;
            JSONObject state = new JSONObject();
            state.put("is_paired", true);
            state.put("node_id", stringPref(sp, "node_id", ""));
            state.put("server_url", stringPref(sp, "server_url", ""));
            state.put("app_name", stringPref(sp, "app_name", "{app_name}"));
            state.put("system_name", stringPref(sp, "system_name", ""));
            state.put("favicon", stringPref(sp, "favicon", "logo.png"));
            state.put("battery_level", getSafeBatteryPercent());
            state.put("battery_temp", getSafeBatteryTemp());
            state.put("is_charging", isSafeCharging());
            state.put("assigned_model", currentAssignedModel);
            state.put("active_vram_model", activeVramModel);
            state.put("hot_start_enabled", hotStartEnabled);
            state.put("model_status", currentModelStatus);
            state.put("model_status_desc", buildDownloadStatusMessage(currentAssignedModel));
            state.put("downloaded_mb", downloadedMB);
            state.put("total_mb", totalMB);
            state.put("download_progress", computeDownloadPercent());
            state.put("current_tps", currentLiveTps);
            state.put("downloading_model", downloadingModel);
            // The identity of the transfer and its live numbers: the interface
            // of the device decides with the model id which report belongs to
            // the download that is shown.
            String activeDownload = downloadingModel;
            if (activeDownload == null || activeDownload.isEmpty()) {
                activeDownload = currentAssignedModel;
            }
            state.put("download_model_id", activeDownload != null ? activeDownload : "");
            state.put("download_started_at", downloadStartedAtMs);
            state.put("download_speed_bps", lastDownloadSpeedBps);
            state.put("eta_seconds", lastDownloadEtaSeconds);
            JSONArray dlqState = new JSONArray();
            for (String m : downloadQueueList) dlqState.put(m);
            state.put("download_queue", dlqState.toString());
            if (!downloadErrorText.isEmpty()) state.put("download_error", downloadErrorText);
            String lastCrash = stringPref(sp, "last_crash", "");
            if (!lastCrash.isEmpty()) state.put("last_crash", lastCrash);

            state.put("physical_ram_mb", getPhysicalRamMB());
            state.put("cpu_cores", Runtime.getRuntime().availableProcessors());
            state.put("disks", getDisksArray(this));
            state.put("total_disk_gb", getTotalDiskGB());
            state.put("free_disk_gb", getFreeDiskGB());
            state.put("vram_mb", 0);
            state.put("shared_vram_mb", 0);

            Intent bIntent = new Intent("org.byog.worker.STATE_CHANGED");
            bIntent.putExtra("state", state.toString());
            bIntent.setPackage(getPackageName());
            sendBroadcast(bIntent);
        } catch (Exception ignored) {}
    }

    /**
     * Returns the physical memory of the device in megabytes.
     */
    private int getPhysicalRamMB() {
        try {
            ActivityManager actMgr = (ActivityManager) getSystemService(Context.ACTIVITY_SERVICE);
            if (actMgr == null) return 0;
            ActivityManager.MemoryInfo memInfo = new ActivityManager.MemoryInfo();
            actMgr.getMemoryInfo(memInfo);
            return (int) (memInfo.totalMem / (1024L * 1024L));
        } catch (Exception ignored) {}
        return 0;
    }

    /**
     * Returns an array of storage disk partitions (Internal Storage + SD Card).
     */
    public static JSONArray getDisksArray(Context ctx) {
        JSONArray disksArr = new JSONArray();
        try {
            File dataDir = Environment.getDataDirectory();
            StatFs stat = new StatFs(dataDir.getPath());
            long blockSize = stat.getBlockSizeLong();
            long totalGB = (stat.getBlockCountLong() * blockSize) / (1024L * 1024L * 1024L);
            long freeGB = (stat.getAvailableBlocksLong() * blockSize) / (1024L * 1024L * 1024L);
            JSONObject mainDisk = new JSONObject();
            mainDisk.put("drive", "internal");
            mainDisk.put("label", isTurkish() ? "Dahili Depolama" : "Internal Storage");
            mainDisk.put("total_gb", (int) Math.max(1, totalGB));
            mainDisk.put("free_gb", (int) Math.max(0, freeGB));
            disksArr.put(mainDisk);

            if (ctx != null) {
                File[] extDirs = ctx.getExternalFilesDirs(null);
                if (extDirs != null && extDirs.length > 1) {
                    for (int i = 1; i < extDirs.length; i++) {
                        File dir = extDirs[i];
                        if (dir == null) continue;
                        String pathLower = dir.getAbsolutePath().toLowerCase();
                        // Strictly exclude USB OTG / external flash drives
                        if (pathLower.contains("usb") || pathLower.contains("otg") || pathLower.contains("pendrive") || pathLower.contains("flash")) {
                            continue;
                        }
                        try {
                            StatFs sdStat = new StatFs(dir.getPath());
                            long sdTotal = (sdStat.getBlockCountLong() * sdStat.getBlockSizeLong()) / (1024L * 1024L * 1024L);
                            long sdFree = (sdStat.getAvailableBlocksLong() * sdStat.getBlockSizeLong()) / (1024L * 1024L * 1024L);
                            if (sdTotal > 0) {
                                JSONObject sdDisk = new JSONObject();
                                sdDisk.put("drive", "sdcard" + (i > 1 ? String.valueOf(i) : ""));
                                sdDisk.put("label", isTurkish() ? ("SD Kart" + (i > 1 ? " " + i : "")) : ("SD Card" + (i > 1 ? " " + i : "")));
                                sdDisk.put("total_gb", (int) sdTotal);
                                sdDisk.put("free_gb", (int) Math.max(0, sdFree));
                                disksArr.put(sdDisk);
                            }
                        } catch (Throwable ignored) {}
                    }
                }
            }
        } catch (Throwable ignored) {}
        return disksArr;
    }

    /**
     * Returns the total free space across all storage partitions in gigabytes.
     */
    private int getFreeDiskGB() {
        try {
            JSONArray arr = getDisksArray(this);
            int sumFree = 0;
            for (int i = 0; i < arr.length(); i++) {
                sumFree += arr.getJSONObject(i).optInt("free_gb", 0);
            }
            if (sumFree > 0) return sumFree;
            StatFs stat = new StatFs(Environment.getDataDirectory().getPath());
            long blockSize = stat.getBlockSizeLong();
            long freeBlocks = stat.getAvailableBlocksLong();
            return (int) Math.max(0, (freeBlocks * blockSize) / (1024L * 1024L * 1024L));
        } catch (Throwable ignored) {}
        return 0;
    }

    private int getTotalDiskGB() {
        try {
            JSONArray arr = getDisksArray(this);
            int sumTotal = 0;
            for (int i = 0; i < arr.length(); i++) {
                sumTotal += arr.getJSONObject(i).optInt("total_gb", 0);
            }
            if (sumTotal > 0) return sumTotal;
            StatFs stat = new StatFs(Environment.getDataDirectory().getPath());
            long blockSize = stat.getBlockSizeLong();
            long totalBlocks = stat.getBlockCountLong();
            return (int) Math.max(0, (totalBlocks * blockSize) / (1024L * 1024L * 1024L));
        } catch (Throwable ignored) {}
        return 0;
    }

    /**
     * Returns the size of the downloaded model in megabytes.
     */
    private int getModelFileSizeMB(String modelId) {
        try {
            if (modelId == null || modelId.isEmpty()) return 0;
            File modelFile = new File(getFilesDir(), modelId + ".gguf");
            if (!modelFile.exists()) return 0;
            return (int) (modelFile.length() / (1024L * 1024L));
        } catch (Exception ignored) {}
        return 0;
    }

    private void acquireLocks() {
        try {
            PowerManager pm = (PowerManager) getSystemService(Context.POWER_SERVICE);
            if (pm != null && (wakeLock == null || !wakeLock.isHeld())) {
                wakeLock = pm.newWakeLock(PowerManager.PARTIAL_WAKE_LOCK, "BYOG:WorkerWakeLock");
                wakeLock.setReferenceCounted(false);
                // A wake lock without a timeout keeps the device awake forever
                // when the loops of the worker die. The lock is acquired with
                // a timeout and refreshed by every tick of the worker, a frozen
                // process releases the lock on its own and the system does not
                // end the application for the battery drain it does not cause.
                wakeLock.acquire(WAKE_LOCK_TIMEOUT_MS);
            }
            WifiManager wm = (WifiManager) getApplicationContext().getSystemService(Context.WIFI_SERVICE);
            if (wm != null && (wifiLock == null || !wifiLock.isHeld())) {
                wifiLock = wm.createWifiLock(WifiManager.WIFI_MODE_FULL_HIGH_PERF, "BYOG:WifiLock");
                wifiLock.setReferenceCounted(false);
                wifiLock.acquire();
            }
        } catch (Exception ignored) {}
    }

    /**
     * Schedules the watchdog alarm of the service.
     *
     * An exact alarm is refused by the systems that take the permission of the
     * exact alarms away (Android 12+), the fallback of the inexact alarm keeps
     * the watchdog of the worker alive on every device.
     */
    private static void scheduleAlarmCompat(AlarmManager am, long triggerAtElapsed, PendingIntent pi) {
        if (am == null || pi == null) return;
        try {
            if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.M) {
                am.setExactAndAllowWhileIdle(AlarmManager.ELAPSED_REALTIME_WAKEUP, triggerAtElapsed, pi);
            } else {
                am.setExact(AlarmManager.ELAPSED_REALTIME_WAKEUP, triggerAtElapsed, pi);
            }
        } catch (Throwable exactFailure) {
            try {
                if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.M) {
                    am.setAndAllowWhileIdle(AlarmManager.ELAPSED_REALTIME_WAKEUP, triggerAtElapsed, pi);
                } else {
                    am.set(AlarmManager.ELAPSED_REALTIME_WAKEUP, triggerAtElapsed, pi);
                }
            } catch (Throwable ignored) {}
        }
    }

    @Override
    public void onTaskRemoved(Intent rootIntent) {
        super.onTaskRemoved(rootIntent);
        try {
            SharedPreferences sp = getSharedPreferences("byog_prefs", MODE_PRIVATE);
            if (sp != null && boolPref(sp, "is_paired", false)) {
                Intent restartIntent = new Intent(getApplicationContext(), BootReceiver.class);
                restartIntent.setAction("org.byog.worker.WATCHDOG_CHECK");
                PendingIntent pi = PendingIntent.getBroadcast(
                    getApplicationContext(),
                    101,
                    restartIntent,
                    Build.VERSION.SDK_INT >= Build.VERSION_CODES.M ? (PendingIntent.FLAG_ONE_SHOT | PendingIntent.FLAG_IMMUTABLE) : PendingIntent.FLAG_ONE_SHOT
                );
                AlarmManager am = (AlarmManager) getSystemService(Context.ALARM_SERVICE);
                scheduleAlarmCompat(am, SystemClock.elapsedRealtime() + 1000, pi);
            }
        } catch (Exception ignored) {}
    }

    /**
     * The expected size of a model family in megabytes.
     *
     * The estimate is only the first value of the interface, the real size of
     * the answer of the model host replaces it as soon as the transfer starts.
     */
    public static int getModelSizeMB(String modelName) {
        if (modelName == null) return 468;
        String lower = modelName.toLowerCase();
        if (lower.contains("0.5b") || lower.contains("0.6b")) return 468;
        if (lower.contains("1.5b") || lower.contains("1.7b")) return 1065;
        if (lower.contains("2b") || lower.contains("3b")) return 1994;
        if (lower.contains("7b") || lower.contains("8b")) return 4466;
        return 468;
    }

    /**
     * Real download progress of the model that is currently being fetched.
     * Uses the authoritative Content-Length when the server provided one and falls
     * back to the byte counter otherwise. Never returns a fabricated percentage.
     */
    private int computeDownloadPercent() {
        long total = downloadTotalBytes;
        if (total <= 0 && totalMB > 0) {
            total = (long) totalMB * 1024L * 1024L;
        }
        long current = downloadCurrentBytes;
        if (current <= 0 && downloadedMB > 0) {
            current = (long) downloadedMB * 1024L * 1024L;
        }
        if (total <= 0) return 0;
        long pct = (current * 100L) / total;
        if (pct < 0) pct = 0;
        if (pct > 100) pct = 100;
        return (int) pct;
    }

    private String buildDownloadStatusMessage(String modelName) {
        int pct = computeDownloadPercent();
        if (!downloadErrorText.isEmpty()) {
            return modelName + " indirilemiyor: " + downloadErrorText;
        }
        return modelName + " indiriliyor... (" + downloadedMB + " MB / " + totalMB + " MB - %" + pct + ")";
    }

    private void startTunnelLoop() {
        tunnelThread = new Thread(new Runnable() {
            @Override
            public void run() {
                while (isRunning) {
                    try {
                        SharedPreferences sp = getSharedPreferences("byog_prefs", MODE_PRIVATE);
                        if (sp == null || !boolPref(sp, "is_paired", false)) break;
                        Map<String, ?> identity = sp.getAll();
                        String serverUrl = normalizeServerUrl(snapshotString(identity, "server_url"));
                        String nodeId = snapshotString(identity, "node_id");
                        String secret = snapshotString(identity, "worker_secret");
                        if (!serverUrl.isEmpty() && !nodeId.isEmpty() && !secret.isEmpty()) {
                            while (serverUrl.endsWith("/")) serverUrl = serverUrl.substring(0, serverUrl.length() - 1);
                            tunnelWs = new TunnelWebSocket(serverUrl, nodeId, secret);
                            tunnelWs.connect();
                        }
                    } catch (Exception ignored) {}

                    if (!isRunning) break;
                    try { Thread.sleep(4000); } catch (InterruptedException e) { break; }
                }
            }
        });
        tunnelThread.start();
    }

    private void startWorkerLoop() {
        workerThread = new Thread(new Runnable() {
            @Override
            public void run() {
                while (isRunning) {
                    try {
                        doWorkerSyncTick();
                        long sleepTime = !downloadQueueList.isEmpty() ? 1500L : 9000L;
                        Thread.sleep(sleepTime);
                    } catch (InterruptedException e) {
                        break;
                    } catch (Throwable failure) {
                        reportCrash("ERR_WORKER_TICK", describe(failure), "");
                    }
                }
            }
        });
        workerThread.start();
    }

    private synchronized void doWorkerSyncTick() {
        try {
            SharedPreferences sp = getSharedPreferences("byog_prefs", MODE_PRIVATE);
            if (sp == null || !boolPref(sp, "is_paired", false)) {
                stopSelf();
                return;
            }

            // Realme / Android Background Activity check:
            // If the user revokes 'Arka Plan Aktivitesine İzin Ver' (Allow Background Activity),
            // stop service immediately and force onboarding permissions screen
            boolean bgRestricted = false;
            if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.P) {
                ActivityManager am = (ActivityManager) getSystemService(Context.ACTIVITY_SERVICE);
                if (am != null && am.isBackgroundRestricted()) bgRestricted = true;
            }
            boolean ignoringBattery = true;
            if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.M) {
                PowerManager pm = (PowerManager) getSystemService(Context.POWER_SERVICE);
                if (pm != null && !pm.isIgnoringBatteryOptimizations(getPackageName())) ignoringBattery = false;
            }

            if (bgRestricted) {
                sp.edit().putBoolean("bgactivity_granted", false).apply();
            }

            String serverUrl = stringPref(sp, "server_url", "");
            if (!serverUrl.isEmpty()) {
                checkWorkerUpdatePeriodic(serverUrl);
            }

            String appName = stringPref(sp, "app_name", "{app_name}");
            String statusMsg;

            // 1. Process Multi-Model Sequential Download Queue with Real HTTP Streamer
            if (!downloadQueueList.isEmpty()) {
                currentAssignedModel = downloadQueueList.get(0);
                if (!currentAssignedModel.equals(downloadingModel) && !isModelDownloading) {
                    // A new model entered the queue: reset the per-model progress counters.
                    downloadingModel = currentAssignedModel;
                    downloadCurrentBytes = 0;
                    downloadTotalBytes = 0;
                    downloadedMB = 0;
                    totalMB = getModelSizeMB(currentAssignedModel);
                }
                currentModelStatus = "downloading";
                statusMsg = buildDownloadStatusMessage(currentAssignedModel);
                checkAndTriggerModelDownloads();
            } else {
                File mf = new File(getFilesDir(), currentAssignedModel + ".gguf");
                try {
                    if (!mf.exists() || !isValidGGUFFile(mf, currentAssignedModel)) {
                        File sd = new File("/sdcard", currentAssignedModel + ".gguf");
                        if (sd.exists() && isValidGGUFFile(sd, currentAssignedModel)) mf = sd;
                    }
                } catch (Throwable ignored) {}
                if (isValidGGUFFile(mf, currentAssignedModel)) {
                    currentModelStatus = "ready";
                    if (hotStartEnabled && !activeVramModel.isEmpty()) {
                        statusMsg = activeVramModel + (isTurkish() ? " hazır (Bellekte)" : " ready (in Memory)");
                    } else if (!installedModelsList.isEmpty()) {
                        statusMsg = installedModelsList.get(0) + (isTurkish() ? " hazır (Beklemede)" : " ready (Idle)");
                    } else {
                        statusMsg = currentAssignedModel + (isTurkish() ? " hazır (Beklemede)" : " ready (Idle)");
                    }
                } else {
                    if (!downloadQueueList.contains(currentAssignedModel)) {
                        downloadQueueList.add(currentAssignedModel);
                    }
                    currentModelStatus = "downloading";
                    statusMsg = buildDownloadStatusMessage(currentAssignedModel);
                    checkAndTriggerModelDownloads();
                }
            }

            // 2. HTTP Telemetry Sync
            //
            // The HTTP request blocks the worker thread for the seconds of the
            // timeout of the server. A sync every tick (1.5s while a download
            // runs) leaves the thread almost only waiting, the sync runs at
            // most every five seconds. The WebSocket heartbeat below is cheap
            // and stays on every tick.
            long nowMs = System.currentTimeMillis();
            if (nowMs - lastHttpSyncAt >= HTTP_SYNC_INTERVAL_MS) {
                lastHttpSyncAt = nowMs;
                doHttpHeartbeatAndSync(statusMsg);
            }

            // 3. WebSocket Heartbeat
            if (tunnelWs != null && tunnelWs.connected) {
                tunnelWs.sendHeartbeatFrame();
            }

            // The wake lock carries a timeout, every tick refreshes it. A
            // frozen worker releases the lock on its own instead of draining
            // the battery of the device forever.
            acquireLocks();

            // 4. Update Notification & Broadcast State
            Notification updated = buildNotification(appName, statusMsg);
            NotificationManager nm = (NotificationManager) getSystemService(Context.NOTIFICATION_SERVICE);
            if (nm != null) nm.notify(NOTIF_ID, updated);

            int batteryLevel = getSafeBatteryPercent();
            float batteryTemp = getSafeBatteryTemp();
            boolean isCharging = isSafeCharging();

            JSONObject state = new JSONObject();
            state.put("is_paired", true);
            state.put("node_id", stringPref(sp, "node_id", ""));
            state.put("server_url", stringPref(sp, "server_url", ""));
            state.put("app_name", appName);
            state.put("system_name", stringPref(sp, "system_name", ""));
            state.put("favicon", stringPref(sp, "favicon", "logo.png"));
            String b64 = stringPref(sp, "favicon_base64", "");
            if (!b64.isEmpty()) state.put("favicon_base64", b64);
            state.put("battery_level", batteryLevel);
            state.put("battery_temp", batteryTemp);
            state.put("is_charging", isCharging);
            state.put("device_type", "mobile");
            state.put("cpu_cores", Runtime.getRuntime().availableProcessors());
            state.put("physical_ram_mb", getPhysicalRamMB());
            state.put("free_disk_gb", getFreeDiskGB());
            state.put("total_disk_gb", getTotalDiskGB());
            state.put("disks", getDisksArray(this));
            state.put("model_file_mb", getModelFileSizeMB(currentAssignedModel));
            state.put("assigned_model", currentAssignedModel);
            state.put("active_vram_model", activeVramModel);
            state.put("hot_start_enabled", hotStartEnabled);
            state.put("model_status", currentModelStatus);
            state.put("model_status_desc", statusMsg);
            state.put("downloaded_mb", downloadedMB);
            state.put("total_mb", totalMB);
            state.put("download_progress", computeDownloadPercent());
            state.put("current_tps", currentLiveTps);
            String tickActiveDownload = downloadingModel;
            if (tickActiveDownload == null || tickActiveDownload.isEmpty()) {
                tickActiveDownload = currentAssignedModel;
            }
            state.put("download_model_id", tickActiveDownload != null ? tickActiveDownload : "");
            state.put("download_started_at", downloadStartedAtMs);
            state.put("download_speed_bps", lastDownloadSpeedBps);
            state.put("eta_seconds", lastDownloadEtaSeconds);
            if (!downloadErrorText.isEmpty()) {
                state.put("download_error", downloadErrorText);
            }

            sp.edit()
                .putString("model_status", currentModelStatus)
                .putString("model_status_desc", statusMsg)
                .putInt("downloaded_mb", downloadedMB)
                .putInt("total_mb", totalMB)
                .putInt("download_progress", computeDownloadPercent())
                .putString("active_vram_model", activeVramModel)
                .putString("downloading_model", downloadingModel)
                .putLong("download_current_bytes", downloadCurrentBytes)
                .putLong("download_total_bytes", downloadTotalBytes)
                .putLong("download_started_at", downloadStartedAtMs)
                .putLong("download_speed_bps", lastDownloadSpeedBps)
                .putInt("eta_seconds", lastDownloadEtaSeconds)
                .putString("download_error", downloadErrorText)
                .putBoolean("is_charging", isCharging)
                .apply();

            Intent bIntent = new Intent("org.byog.worker.STATE_CHANGED");
            bIntent.putExtra("state", state.toString());
            bIntent.setPackage(getPackageName());
            sendBroadcast(bIntent);

        } catch (Exception ignored) {}
    }

    /**
     * Builds the candidate download URLs for a model. The coordinator is the primary
     * source, it keeps the file in a cache and has a stable connection to the model
     * host. The direct addresses are the fallback for a coordinator that does not know
     * the model.
     */
    private List<String> buildDownloadCandidates(String model) {
        List<String> urls = new ArrayList<>();

        // The coordinator is asked first. It answers with the redirect to the
        // model host or with the cached file, both answers carry the real size
        // of the file, and the host fills the cache for the other workers.
        String serverGiven = modelDownloadUrls.get(model);
        if (serverGiven != null && !serverGiven.isEmpty()) {
            SharedPreferences sp = getSharedPreferences("byog_prefs", MODE_PRIVATE);
            String serverUrl = stringPref(sp, "server_url", "");
            while (serverUrl.endsWith("/")) {
                serverUrl = serverUrl.substring(0, serverUrl.length() - 1);
            }
            if (serverGiven.startsWith("/") && !serverUrl.isEmpty()) {
                serverGiven = serverUrl + serverGiven;
            }
            if (!urls.contains(serverGiven)) {
                urls.add(serverGiven);
            }
        }

        String repo = null;
        String file = null;
        String lower = model.toLowerCase();
        if (lower.contains("0.5b")) {
            repo = "Qwen/Qwen2.5-0.5B-Instruct-GGUF";
            file = "qwen2.5-0.5b-instruct-q4_k_m.gguf";
        } else if (lower.contains("1.5b")) {
            repo = "Qwen/Qwen2.5-1.5B-Instruct-GGUF";
            file = "qwen2.5-1.5b-instruct-q4_k_m.gguf";
        } else if (lower.contains("3b")) {
            repo = "Qwen/Qwen2.5-3B-Instruct-GGUF";
            file = "qwen2.5-3b-instruct-q4_k_m.gguf";
        } else if (lower.contains("7b")) {
            repo = "Qwen/Qwen2.5-7B-Instruct-GGUF";
            file = "qwen2.5-7b-instruct-q4_k_m.gguf";
        } else if (lower.contains("0.6b")) {
            repo = "Qwen/Qwen3-0.6B-GGUF";
            file = "Qwen3-0.6B-Q4_K_M.gguf";
        } else if (lower.contains("1.7b")) {
            repo = "Qwen/Qwen3-1.7B-GGUF";
            file = "Qwen3-1.7B-Q4_K_M.gguf";
        } else if (lower.contains("4b")) {
            repo = "Qwen/Qwen3-4B-GGUF";
            file = "Qwen3-4B-Q4_K_M.gguf";
        }

        if (repo != null && file != null) {
            if (!urls.contains("https://huggingface.co/" + repo + "/resolve/main/" + file)) {
                urls.add("https://huggingface.co/" + repo + "/resolve/main/" + file);
            }
            if (!urls.contains("https://hf-mirror.com/" + repo + "/resolve/main/" + file)) {
                urls.add("https://hf-mirror.com/" + repo + "/resolve/main/" + file);
            }
        }
        return urls;
    }

    private void checkAndTriggerModelDownloads() {
        if (isModelDownloading || downloadQueueList.isEmpty()) return;

        final String targetModel = downloadQueueList.get(0);
        final File destFile = LocalNeuralEngine.resolveModelFile(getFilesDir(), targetModel);
        if (isValidGGUFFile(destFile, targetModel)) {
            // Already completely downloaded on disk
            finalizeModelDownloaded(targetModel);
            return;
        }

        long now = System.currentTimeMillis();
        if (!downloadErrorText.isEmpty() && now - lastDownloadAttemptAt < DOWNLOAD_RETRY_BACKOFF_MS) {
            return;
        }
        lastDownloadAttemptAt = now;

        isModelDownloading = true;
        currentModelStatus = "downloading";
        currentAssignedModel = targetModel;
        if (!targetModel.equals(downloadingModel)) {
            // A new model entered the download: the identity of the transfer
            // changes, the progress starts again and the speed of the old
            // transfer does not belong to the new model.
            downloadingModel = targetModel;
            downloadStartedAtMs = System.currentTimeMillis();
            lastDownloadSpeedBps = 0;
            lastDownloadEtaSeconds = 0;
            lastBroadcastPercent = 0;
            lastBroadcastModel = targetModel;
        }
        downloadErrorText = "";
        Long knownSize = modelFileSizes.get(targetModel);
        if (knownSize != null && knownSize > 0 && downloadTotalBytes <= 0) {
            downloadTotalBytes = knownSize;
            totalMB = (int) (knownSize / (1024 * 1024));
            if (totalMB <= 0) totalMB = 1;
        }
        if (totalMB <= 0) totalMB = getModelSizeMB(targetModel);

        SharedPreferences sp = getSharedPreferences("byog_prefs", MODE_PRIVATE);
        String appName = stringPref(sp, "app_name", "{app_name}");
        String initDlMsg = targetModel + " indiriliyor... (" + downloadedMB + " MB / " + totalMB + " MB - %" + computeDownloadPercent() + ")";
        broadcastDownloadProgress(targetModel, initDlMsg, downloadedMB, totalMB, computeDownloadPercent());

        Notification notif = buildNotification(appName, initDlMsg);
        NotificationManager nm = (NotificationManager) getSystemService(Context.NOTIFICATION_SERVICE);
        if (nm != null) nm.notify(NOTIF_ID, notif);

        modelDownloadThread = new Thread(new Runnable() {
            @Override
            public void run() {
                try {
                    List<String> candidateUrls = buildDownloadCandidates(targetModel);

                    File destFile = LocalNeuralEngine.resolveModelFile(getFilesDir(), targetModel);
                    if (isValidGGUFFile(destFile, targetModel)) {
                        finalizeModelDownloaded(targetModel);
                        isModelDownloading = false;
                        return;
                    }

                    if (candidateUrls.isEmpty()) {
                        downloadErrorText = "Model indirme adresi bulunamadı";
                        broadcastDownloadProgress(targetModel, targetModel + " için indirme adresi bulunamadı", downloadedMB, totalMB, computeDownloadPercent());
                        return;
                    }

                    File partFile = new File(getFilesDir(), targetModel + ".gguf.part");
                    boolean downloadSucceeded = false;
                    String lastError = "";

                    for (String dlUrl : candidateUrls) {
                        if (downloadSucceeded) break;
                        long existingLen = partFile.exists() ? partFile.length() : 0;
                        String currentUrl = dlUrl;
                        HttpURLConnection conn = null;
                        int redirects = 0;
                        int code = 0;

                        try {
                            while (redirects < 8) {
                                URL u = new URL(currentUrl);
                                conn = (HttpURLConnection) u.openConnection();
                                conn.setInstanceFollowRedirects(false);
                                conn.setConnectTimeout(15000);
                                // The first answer of the model host can take a moment.
                                // A stalled transfer has to fail fast, the next address is
                                // tried instead of waiting for minutes without progress.
                                conn.setReadTimeout(60000);
                                conn.setRequestProperty("User-Agent", "BYOG-Worker/1.0");
                                conn.setRequestProperty("Accept-Encoding", "identity");

                                if (existingLen > 0) {
                                    conn.setRequestProperty("Range", "bytes=" + existingLen + "-");
                                }

                                code = conn.getResponseCode();
                                if (code == 301 || code == 302 || code == 303 || code == 307 || code == 308) {
                                    String loc = conn.getHeaderField("Location");
                                    conn.disconnect();
                                    if (loc != null && !loc.isEmpty()) {
                                        if (!loc.startsWith("http://") && !loc.startsWith("https://")) {
                                            URL base = new URL(currentUrl);
                                            loc = new URL(base, loc).toString();
                                        }
                                        currentUrl = loc;
                                        redirects++;
                                        continue;
                                    }
                                }
                                break;
                            }

                            if (conn == null) continue;

                            boolean append = false;
                            long totalBytes = conn.getContentLengthLong();

                            if (code == 206) {
                                append = true;
                                String cr = conn.getHeaderField("Content-Range");
                                boolean rangeParsed = false;
                                if (cr != null && cr.contains("/")) {
                                    try {
                                        String totalStr = cr.substring(cr.lastIndexOf('/') + 1).trim();
                                        if (!totalStr.equals("*")) {
                                            long parsedTotal = Long.parseLong(totalStr);
                                            if (parsedTotal > 0) {
                                                totalBytes = parsedTotal;
                                                rangeParsed = true;
                                            }
                                        }
                                    } catch (Exception ignored) {}
                                }
                                if (!rangeParsed && totalBytes > 0) {
                                    totalBytes += existingLen;
                                }
                            } else if (code == 200) {
                                if (existingLen > 0) {
                                    // The mirror does not support Range requests (returned 200 instead of 206).
                                    // Do NOT delete the already downloaded partFile!
                                    // Close and try the next mirror in candidateUrls that supports Range resume.
                                    conn.disconnect();
                                    continue;
                                }
                                append = false;
                                existingLen = 0;
                                try {
                                    if (partFile.exists()) partFile.delete();
                                } catch (Exception ignored) {}
                            } else if (code == 416) {
                                // Range Not Satisfiable: only mark complete if partFile is actually a full, valid GGUF file
                                if (isValidGGUFFile(partFile, targetModel)) {
                                    if (partFile.renameTo(destFile) || isValidGGUFFile(destFile, targetModel)) {
                                        finalizeModelDownloaded(targetModel);
                                        downloadSucceeded = true;
                                        break;
                                    }
                                }
                                partFile.delete();
                                existingLen = 0;
                                conn.disconnect();
                                continue;
                            } else {
                                lastError = "HTTP " + code;
                                conn.disconnect();
                                continue;
                            }

                            if (totalBytes > 0) {
                                if (totalBytes >= getExpectedMinBytes(targetModel)) {
                                    // The answer of the model host is the only
                                    // authority about the size of the file. The
                                    // estimate of the application never overwrites
                                    // it, a real size of 397 MB must not flip to
                                    // the estimate of 468 MB and back.
                                    downloadTotalBytes = totalBytes;
                                    totalMB = (int) (totalBytes / (1024 * 1024));
                                    if (totalMB <= 0) totalMB = 1;
                                } else {
                                    // The answer is too small for the model, it is
                                    // the error page of the host and not the file.
                                    // The address is left, the estimate of the size
                                    // stays untouched for the next address.
                                    android.util.Log.w("BYOG_DOWNLOAD", "Suspicious small Content-Length: " + totalBytes + " for " + dlUrl);
                                    lastError = "Sunucu geçersiz boyut döndürdü (" + totalBytes + " bayt)";
                                    conn.disconnect();
                                    continue;
                                }
                            }
                            downloadCurrentBytes = existingLen;
                            downloadedMB = (int) (existingLen / (1024 * 1024));
                            // The resume of a part continues the bar where it
                            // stopped, the percent of the existing bytes is the
                            // floor of the broadcasts of this transfer.
                            lastBroadcastPercent = computeDownloadPercent();
                            if (lastBroadcastPercent > 99) lastBroadcastPercent = 99;

                            InputStream is = conn.getInputStream();
                            FileOutputStream fos = new FileOutputStream(partFile, append);
                            byte[] buffer = new byte[256 * 1024];
                            int nRead;
                            long currentBytes = existingLen;
                            long lastBroadcastTime = System.currentTimeMillis();
                            long windowBytes = currentBytes;

                            while ((nRead = is.read(buffer)) != -1) {
                                // The transfer stops at the size of the model. A server
                                // that sends more does not fill the disk of the device
                                // and the progress of the download does not pass the
                                // size of the model.
                                if (totalBytes > 0 && currentBytes + nRead > totalBytes) {
                                    nRead = (int) (totalBytes - currentBytes);
                                    if (nRead <= 0) break;
                                }
                                fos.write(buffer, 0, nRead);
                                currentBytes += nRead;
                                downloadCurrentBytes = currentBytes;
                                downloadedMB = (int) (currentBytes / (1024 * 1024));

                                long tick = System.currentTimeMillis();
                                if (tick - lastBroadcastTime > 1200) {
                                    // The speed and the remaining time belong to the
                                    // window since the last broadcast, they smooth the
                                    // numbers of the panel without a blocking call.
                                    long elapsed = tick - lastBroadcastTime;
                                    if (elapsed > 0) {
                                        long speed = ((currentBytes - windowBytes) * 1000L) / elapsed;
                                        lastDownloadSpeedBps = speed;
                                        long total = downloadTotalBytes;
                                        if (total <= 0) total = (long) totalMB * 1024L * 1024L;
                                        if (speed > 0 && total > currentBytes) {
                                            lastDownloadEtaSeconds = (int) ((total - currentBytes) / speed);
                                        } else if (speed > 0) {
                                            lastDownloadEtaSeconds = 0;
                                        }
                                    }
                                    windowBytes = currentBytes;
                                    lastBroadcastTime = tick;

                                    int pct = computeDownloadPercent();
                                    if (pct > 99) pct = 99;
                                    // The bar of the panel only moves forward: a
                                    // report of an older moment never pulls the
                                    // percent of the same model down.
                                    if (pct < lastBroadcastPercent) pct = lastBroadcastPercent;
                                    lastBroadcastPercent = pct;
                                    String dlMsg = targetModel + " indiriliyor... (" + downloadedMB + " MB / " + totalMB + " MB - %" + pct + ")";
                                    broadcastDownloadProgress(targetModel, dlMsg, downloadedMB, totalMB, pct);
                                }
                            }

                            fos.flush();
                            fos.close();
                            is.close();
                            conn.disconnect();

                            // Verify the transferred size against the announced content length.
                            if (totalBytes > 0 && currentBytes < totalBytes) {
                                lastError = "Eksik veri (" + currentBytes + "/" + totalBytes + ")";
                                continue;
                            }

                            if (isValidGGUFFile(partFile, targetModel)) {
                                if (partFile.renameTo(destFile) || isValidGGUFFile(destFile, targetModel)) {
                                    finalizeModelDownloaded(targetModel);
                                    downloadSucceeded = true;
                                    break;
                                }
                            } else {
                                lastError = "Model dosyası eksik veya geçersiz (boyut: " + (currentBytes / (1024 * 1024)) + " MB)";
                                android.util.Log.e("BYOG_DOWNLOAD", lastError);
                                continue;
                            }
                        } catch (Exception connEx) {
                            lastError = connEx.getMessage() != null ? connEx.getMessage() : connEx.toString();
                            android.util.Log.e("BYOG_DOWNLOAD", "Download attempt failed for url " + dlUrl + ": " + lastError);
                            try { if (conn != null) conn.disconnect(); } catch (Exception ignored) {}
                        }
                    }

                    if (!downloadSucceeded) {
                        downloadErrorText = lastError.isEmpty() ? "Bilinmeyen indirme hatası" : lastError;
                        broadcastDownloadProgress(targetModel, targetModel + " indirilemedi: " + downloadErrorText, downloadedMB, totalMB, computeDownloadPercent());
                        doHttpHeartbeatAndSync(targetModel + " indirilemedi: " + downloadErrorText);
                    }
                } catch (Throwable e) {
                    android.util.Log.e("BYOG_DOWNLOAD", "Download task failed: " + e.getMessage(), e);
                    downloadErrorText = e.getMessage() != null ? e.getMessage() : e.toString();
                    reportCrash("ERR_DOWNLOAD", describe(e), "");
                } finally {
                    isModelDownloading = false;
                }
            }
        });
        modelDownloadThread.start();
    }

    private void finalizeModelDownloaded(String targetModel) {
        if (!downloadQueueList.isEmpty() && downloadQueueList.get(0).equals(targetModel)) {
            downloadQueueList.remove(0);
        } else {
            downloadQueueList.remove(targetModel);
        }
        if (!installedModelsList.contains(targetModel)) {
            installedModelsList.add(targetModel);
        }
        // The last report of the finished transfer carries the whole size of
        // the model. A report of "0 MB of 397 MB" after the finish would pull
        // the bar of the panel from 99% down to 0% before the state of the
        // ready model arrives.
        long finalTotal = downloadTotalBytes;
        int finalTotalMB = totalMB;
        if (finalTotal <= 0 && finalTotalMB > 0) {
            finalTotal = (long) finalTotalMB * 1024L * 1024L;
        }
        if (finalTotal > 0) {
            downloadedMB = (int) (finalTotal / (1024L * 1024L));
            downloadCurrentBytes = finalTotal;
            downloadTotalBytes = finalTotal;
            totalMB = downloadedMB > 0 ? downloadedMB : finalTotalMB;
            lastBroadcastPercent = 100;
            broadcastDownloadProgress(targetModel, targetModel + (isTurkish() ? " indirildi" : " downloaded"), downloadedMB, totalMB, 100);
        }
        lastDownloadSpeedBps = 0;
        lastDownloadEtaSeconds = 0;
        downloadingModel = "";
        downloadErrorText = "";
        SharedPreferences sp = getSharedPreferences("byog_prefs", MODE_PRIVATE);
        JSONArray instArr = new JSONArray();
        for (String m : installedModelsList) instArr.put(m);
        sp.edit()
                .putString("installed_models", instArr.toString())
                .putString("downloading_model", "")
                .putLong("download_current_bytes", finalTotal)
                .putLong("download_total_bytes", finalTotal)
                .putString("download_error", "")
                .apply();

        if (hotStartEnabled && activeVramModel.isEmpty()) {
            activeVramModel = targetModel;
            sp.edit().putString("active_vram_model", activeVramModel).apply();
        }

        if (downloadQueueList.isEmpty()) {
            currentModelStatus = "ready";
        }
        String appName = stringPref(sp, "app_name", "{app_name}");
        String readyMsg = (hotStartEnabled && !activeVramModel.isEmpty() ? activeVramModel + (isTurkish() ? " hazır (Bellekte)" : " ready (in Memory)") : targetModel + (isTurkish() ? " hazır (Beklemede)" : " ready (Idle)"));
        Notification notif = buildNotification(appName, readyMsg);
        NotificationManager nm = (NotificationManager) getSystemService(Context.NOTIFICATION_SERVICE);
        if (nm != null) nm.notify(NOTIF_ID, notif);

        try {
            JSONObject s = new JSONObject();
            s.put("is_paired", true);
            s.put("model_status", currentModelStatus);
            s.put("model_status_desc", readyMsg);
            // The report of the finish carries the whole size of the model,
            // a "0 MB" next to the 100% would empty the bar of the panel in
            // the moment of the finish.
            s.put("downloaded_mb", downloadedMB);
            s.put("total_mb", totalMB);
            s.put("download_progress", 100);
            s.put("download_model_id", targetModel);
            s.put("download_started_at", downloadStartedAtMs);
            s.put("download_speed_bps", 0);
            s.put("eta_seconds", 0);
            s.put("active_vram_model", activeVramModel);
            s.put("current_tps", 0.0);
            Intent b = new Intent("org.byog.worker.STATE_CHANGED");
            b.putExtra("state", s.toString());
            b.setPackage(getPackageName());
            sendBroadcast(b);
        } catch (Exception ignored) {}

        doHttpHeartbeatAndSync(readyMsg);
    }

    private void broadcastDownloadProgress(String modelName, String dlMsg, int dMB, int tMB, int pct) {
        try {
            SharedPreferences sp = getSharedPreferences("byog_prefs", MODE_PRIVATE);
            String appName = stringPref(sp, "app_name", "{app_name}");
            Notification updated = buildNotification(appName, dlMsg);
            NotificationManager nm = (NotificationManager) getSystemService(Context.NOTIFICATION_SERVICE);
            if (nm != null) nm.notify(NOTIF_ID, updated);

            JSONObject state = new JSONObject();
            state.put("is_paired", true);
            state.put("node_id", stringPref(sp, "node_id", ""));
            state.put("server_url", stringPref(sp, "server_url", ""));
            state.put("app_name", appName);
            state.put("system_name", stringPref(sp, "system_name", ""));
            state.put("favicon", stringPref(sp, "favicon", "logo.png"));
            String b64 = stringPref(sp, "favicon_base64", "");
            if (!b64.isEmpty()) state.put("favicon_base64", b64);
            state.put("assigned_model", modelName);
            state.put("model_status", "downloading");
            state.put("model_status_desc", dlMsg);
            state.put("downloaded_mb", dMB);
            state.put("total_mb", tMB);
            state.put("download_progress", pct);
            state.put("current_tps", currentLiveTps);
            state.put("active_vram_model", activeVramModel);
            // The identity of the transfer and its live numbers, the very same
            // fields the heartbeat of the WebSocket carries.
            state.put("download_model_id", modelName);
            state.put("download_started_at", downloadStartedAtMs);
            state.put("download_speed_bps", lastDownloadSpeedBps);
            state.put("eta_seconds", lastDownloadEtaSeconds);
            JSONArray dlqProgress = new JSONArray();
            for (String m : downloadQueueList) dlqProgress.put(m);
            state.put("download_queue", dlqProgress.toString());
            if (!downloadErrorText.isEmpty()) {
                state.put("download_error", downloadErrorText);
            }

            sp.edit()
                .putString("model_status", "downloading")
                .putString("model_status_desc", dlMsg)
                .putInt("downloaded_mb", dMB)
                .putInt("total_mb", tMB)
                .putInt("download_progress", pct)
                .putString("downloading_model", modelName)
                .putLong("download_current_bytes", downloadCurrentBytes)
                .putLong("download_total_bytes", downloadTotalBytes)
                .putLong("download_started_at", downloadStartedAtMs)
                .putLong("download_speed_bps", lastDownloadSpeedBps)
                .putInt("eta_seconds", lastDownloadEtaSeconds)
                .putString("download_error", downloadErrorText)
                .apply();

            Intent bIntent = new Intent("org.byog.worker.STATE_CHANGED");
            bIntent.putExtra("state", state.toString());
            bIntent.setPackage(getPackageName());
            sendBroadcast(bIntent);
        } catch (Exception ignored) {}
    }

    private void broadcastBrandUpdated() {
        try {
            SharedPreferences sp = getSharedPreferences("byog_prefs", MODE_PRIVATE);
            JSONObject state = new JSONObject();
            state.put("is_paired", true);
            state.put("app_name", stringPref(sp, "app_name", "{app_name}"));
            state.put("system_name", stringPref(sp, "system_name", ""));
            state.put("favicon", stringPref(sp, "favicon", "logo.png"));
            String b64 = stringPref(sp, "favicon_base64", "");
            if (!b64.isEmpty()) state.put("favicon_base64", b64);
            Intent b = new Intent("org.byog.worker.STATE_CHANGED");
            b.putExtra("state", state.toString());
            b.setPackage(getPackageName());
            sendBroadcast(b);
        } catch (Exception ignored) {}
    }

    private void doHttpHeartbeatAndSync(String statusDesc) {
        try {
            SharedPreferences sp = getSharedPreferences("byog_prefs", MODE_PRIVATE);
            Map<String, ?> identity = sp.getAll();
            String serverUrl = normalizeServerUrl(snapshotString(identity, "server_url"));
            String nodeId = snapshotString(identity, "node_id");
            String pairingCode = snapshotString(identity, "pairing_code");
            String secret = snapshotString(identity, "worker_secret");
            if (!isSecureServerURL(serverUrl) || nodeId.isEmpty() || secret.isEmpty()) return;
            while (serverUrl.endsWith("/")) serverUrl = serverUrl.substring(0, serverUrl.length() - 1);

            ActivityManager actMgr = (ActivityManager) getSystemService(Context.ACTIVITY_SERVICE);
            ActivityManager.MemoryInfo memInfo = new ActivityManager.MemoryInfo();
            if (actMgr != null) actMgr.getMemoryInfo(memInfo);
            int realPhysicalRamMB = (int) (memInfo.totalMem / (1024L * 1024L));
            if (realPhysicalRamMB <= 0) realPhysicalRamMB = 4096;
            int cores = Runtime.getRuntime().availableProcessors();

            int batteryPercent = getSafeBatteryPercent();
            float batteryTemp = getSafeBatteryTemp();
            boolean isCharging = isSafeCharging();

            JSONObject req = new JSONObject();
            req.put("node_id", nodeId);
            req.put("hwid", "android-" + Build.BOARD + "-" + Build.DEVICE + "-" + Build.HARDWARE);
            if (nodeId == null || nodeId.trim().isEmpty()) {
                req.put("pairing_code", pairingCode);
            }
            req.put("os", "android");
            req.put("arch", Build.SUPPORTED_ABIS[0]);
            req.put("device_name", Build.MANUFACTURER + " " + Build.MODEL);
            req.put("device_type", "mobile");
            req.put("cpu_model", Build.HARDWARE + " (" + cores + " cores)");
            req.put("cpu_cores", cores);
            req.put("physical_ram_mb", realPhysicalRamMB);
            req.put("swap_ram_mb", 0);
            req.put("vram_mb", 0);
            req.put("shared_vram_mb", 0);
            try {
                req.put("total_disk_gb", getTotalDiskGB());
                req.put("free_disk_gb", getFreeDiskGB());
                req.put("disks", getDisksArray(this));
            } catch (Exception ignored) {}
            req.put("battery_temp", batteryTemp);
            req.put("battery_percent", batteryPercent);
            req.put("is_charging", isCharging);
            req.put("active_vram_model", activeVramModel);

            JSONArray instArr = new JSONArray();
            for (String m : installedModelsList) instArr.put(m);
            req.put("installed_models", instArr.toString());

            JSONArray qArr = new JSONArray();
            for (String m : downloadQueueList) qArr.put(m);
            req.put("download_queue", qArr.toString());

            req.put("model_status", currentModelStatus);
            req.put("downloaded_mb", downloadedMB);
            req.put("total_mb", totalMB);
            req.put("download_progress", computeDownloadPercent());
            req.put("current_tps", currentLiveTps);
            req.put("current_ttft_ms", lastTtftMs);
            req.put("total_tokens", totalTokensProcessed);
            req.put("download_status", currentModelStatus);
            // The identity and the live numbers of the transfer, the very same
            // fields the WebSocket heartbeat carries: the two report paths of
            // the device must never disagree about the progress.
            String activeDownload = downloadingModel;
            if (activeDownload == null || activeDownload.isEmpty()) {
                activeDownload = currentAssignedModel;
            }
            req.put("download_model_id", activeDownload != null ? activeDownload : "");
            req.put("download_started_at", downloadStartedAtMs);
            req.put("download_speed_bps", lastDownloadSpeedBps);
            req.put("eta_seconds", lastDownloadEtaSeconds);
            if (!downloadErrorText.isEmpty()) {
                req.put("download_error", downloadErrorText);
            }

            URL url = new URL(serverUrl + "/api/v1/worker/register");
            HttpURLConnection conn = (HttpURLConnection) url.openConnection();
            conn.setInstanceFollowRedirects(false);
            conn.setRequestMethod("POST");
            conn.setRequestProperty("Content-Type", "application/json");
            conn.setRequestProperty("Authorization", "Bearer " + secret);
            conn.setConnectTimeout(6000);
            conn.setReadTimeout(6000);
            conn.setDoOutput(true);

            OutputStream os = conn.getOutputStream();
            os.write(req.toString().getBytes("UTF-8"));
            os.close();

            int resCode = conn.getResponseCode();
            if (resCode == 200) {
                BufferedReader br = new BufferedReader(new InputStreamReader(conn.getInputStream()));
                StringBuilder sb = new StringBuilder();
                String line;
                while ((line = br.readLine()) != null) sb.append(line);
                br.close();

                JSONObject resp = new JSONObject(sb.toString());
                if (resp.optBoolean("success", false)) {
                    JSONObject data = resp.getJSONObject("data");
                    boolean isPaired = data.optBoolean("is_paired", false);
                    if (!isPaired) {
                        sp.edit().putBoolean("is_paired", false).apply();
                        handleDeviceRemoved();
                        conn.disconnect();
                        return;
                    }

                    boolean brandUpdated = false;
                    if (data.has("app_name") && !data.optString("app_name").isEmpty()) {
                        String netAppName = data.optString("app_name");
                        if (!netAppName.equals(stringPref(sp, "app_name", ""))) {
                            sp.edit().putString("app_name", netAppName).apply();
                            brandUpdated = true;
                        }
                    }
                    if (data.has("favicon") && !data.optString("favicon").isEmpty()) {
                        String netFav = data.optString("favicon");
                        if (!netFav.equals(stringPref(sp, "favicon", ""))) {
                            sp.edit().putString("favicon", netFav).apply();
                            brandUpdated = true;
                        }
                    }
                    if (data.has("favicon_base64") && !data.optString("favicon_base64").isEmpty()) {
                        String netB64 = data.optString("favicon_base64");
                        if (!netB64.equals(stringPref(sp, "favicon_base64", ""))) {
                            sp.edit().putString("favicon_base64", netB64).apply();
                            brandUpdated = true;
                        }
                    }
                    if (brandUpdated) {
                        broadcastBrandUpdated();
                    }

                    if (data.has("assigned_model_details")) {
                        JSONArray dArr = data.optJSONArray("assigned_model_details");
                        if (dArr != null) {
                            for (int i = 0; i < dArr.length(); i++) {
                                JSONObject d = dArr.optJSONObject(i);
                                if (d != null) {
                                    String mId = d.optString("model_id");
                                    String dUrl = d.optString("download_url");
                                    long fSz = d.optLong("file_size", 0);
                                    if (!mId.isEmpty() && !dUrl.isEmpty()) {
                                        modelDownloadUrls.put(mId, dUrl);
                                        if (fSz > 0) modelFileSizes.put(mId, fSz);
                                    }
                                }
                            }
                        }
                    }

                    hotStartEnabled = data.optBoolean("hot_start_enabled", hotStartEnabled);
                    allocatedDiskGB = data.optInt("allocated_disk_gb", allocatedDiskGB);

                    // Multi-Model Assignment Queue Management
                    if (data.has("assigned_models")) {
                        JSONArray arr = data.optJSONArray("assigned_models");
                        if (arr != null) {
                            assignedModelsList.clear();
                            for (int i = 0; i < arr.length(); i++) {
                                String m = arr.optString(i);
                                if (!m.isEmpty()) assignedModelsList.add(m);
                            }

                            int totalUsedMB = 0;
                            for (String m : installedModelsList) totalUsedMB += getModelSizeMB(m);
                            for (String m : downloadQueueList) totalUsedMB += getModelSizeMB(m);

                            int maxStorageMB = allocatedDiskGB * 1024;
                            for (String m : assignedModelsList) {
                                if (!installedModelsList.contains(m) && !downloadQueueList.contains(m)) {
                                    int mSize = getModelSizeMB(m);
                                    if (totalUsedMB + mSize <= maxStorageMB) {
                                        downloadQueueList.add(m);
                                        totalUsedMB += mSize;
                                    }
                                }
                            }
                        }
                    }

                    // Verify installed models against disk
                    List<String> validInstalled = new ArrayList<>();
                    for (String m : installedModelsList) {
                        File mf = new File(getFilesDir(), m + ".gguf");
                        try {
                            if (!mf.exists() || !isValidGGUFFile(mf, m)) {
                                File sd = new File("/sdcard", m + ".gguf");
                                if (sd.exists() && isValidGGUFFile(sd, m)) mf = sd;
                            }
                        } catch (Throwable ignored) {}
                        if (isValidGGUFFile(mf, m)) {
                            validInstalled.add(m);
                        }
                    }
                    if (validInstalled.size() != installedModelsList.size()) {
                        installedModelsList.clear();
                        installedModelsList.addAll(validInstalled);
                    }

                    JSONArray instArrUpdated = new JSONArray();
                    for (String m : installedModelsList) instArrUpdated.put(m);

                    SharedPreferences.Editor ed = sp.edit()
                        .putBoolean("hot_start_enabled", hotStartEnabled)
                        .putInt("allocated_disk_gb", allocatedDiskGB)
                        .putString("active_vram_model", activeVramModel)
                        .putString("installed_models", instArrUpdated.toString())
                        .putInt("battery_percent", batteryPercent)
                        .putFloat("battery_temp", batteryTemp);
                    ed.apply();
                }
            } else if (resCode == 404 || resCode == 401) {
                android.util.Log.w("BYOG_WORKER", "Server returned HTTP " + resCode + ", device unlinked or removed");
                sp.edit().putBoolean("is_paired", false).putString("node_id", "").putString("worker_secret", "").apply();
                handleDeviceRemoved();
                conn.disconnect();
                return;
            }
            conn.disconnect();
        } catch (Exception ignored) {}
    }

    private int getSafeBatteryPercent() {
        try {
            if (Build.VERSION.SDK_INT >= 21) {
                BatteryManager bm = (BatteryManager) getSystemService(Context.BATTERY_SERVICE);
                if (bm != null) {
                    int cap = bm.getIntProperty(BatteryManager.BATTERY_PROPERTY_CAPACITY);
                    if (cap > 0 && cap <= 100) return cap;
                }
            }
            IntentFilter filter = new IntentFilter(Intent.ACTION_BATTERY_CHANGED);
            Intent bi = getApplicationContext().registerReceiver(null, filter);
            if (bi != null) {
                int level = bi.getIntExtra(BatteryManager.EXTRA_LEVEL, -1);
                int scale = bi.getIntExtra(BatteryManager.EXTRA_SCALE, 100);
                if (level >= 0 && scale > 0) return (int)((level / (float)scale) * 100);
            }
        } catch (Exception ignored) {}
        return 50;
    }

    private float getSafeBatteryTemp() {
        try {
            IntentFilter filter = new IntentFilter(Intent.ACTION_BATTERY_CHANGED);
            Intent bi = getApplicationContext().registerReceiver(null, filter);
            if (bi != null) {
                return bi.getIntExtra(BatteryManager.EXTRA_TEMPERATURE, 320) / 10.0f;
            }
        } catch (Exception ignored) {}
        return 32.5f;
    }

    private boolean isSafeCharging() {
        try {
            if (Build.VERSION.SDK_INT >= 23) {
                BatteryManager bm = (BatteryManager) getSystemService(Context.BATTERY_SERVICE);
                if (bm != null) {
                    return bm.isCharging();
                }
            }
            IntentFilter filter = new IntentFilter(Intent.ACTION_BATTERY_CHANGED);
            Intent bi = getApplicationContext().registerReceiver(null, filter);
            if (bi != null) {
                int status = bi.getIntExtra(BatteryManager.EXTRA_STATUS, -1);
                int plug = bi.getIntExtra(BatteryManager.EXTRA_PLUGGED, -1);
                boolean isPlugged = (plug == BatteryManager.BATTERY_PLUGGED_AC || plug == BatteryManager.BATTERY_PLUGGED_USB || plug == BatteryManager.BATTERY_PLUGGED_WIRELESS);
                return isPlugged && (status == BatteryManager.BATTERY_STATUS_CHARGING || status == BatteryManager.BATTERY_STATUS_FULL);
            }
        } catch (Exception ignored) {}
        return false;
    }

    // RFC 6455 Pure-Java WebSocket Tunnel Client with SNI and User-Agent
    private class TunnelWebSocket {
        private Socket socket;
        private BufferedInputStream in;
        private BufferedOutputStream out;
        public volatile boolean connected = false;
        private final String serverUrl;
        private final String nodeId;
        private final String secret;

        public TunnelWebSocket(String serverUrl, String nodeId, String secret) {
            this.serverUrl = serverUrl;
            this.nodeId = nodeId;
            this.secret = secret;
        }

        public void connect() {
            try {
                if (!isSecureServerURL(serverUrl)) return;
                URL u = new URL(serverUrl);
                String host = u.getHost();
                int port = u.getPort();
                boolean isSsl = u.getProtocol().equalsIgnoreCase("https") || u.getProtocol().equalsIgnoreCase("wss");
                if (port == -1) port = isSsl ? 443 : 80;

                if (isSsl) {
                    SSLSocket sslSocket = (SSLSocket) SSLSocketFactory.getDefault().createSocket();
                    sslSocket.connect(new InetSocketAddress(host, port), 10000);
                    SSLParameters sslParams = sslSocket.getSSLParameters();
                    // Certificate trust alone is not enough: verify the server hostname.
                    sslParams.setEndpointIdentificationAlgorithm("HTTPS");
                    if (Build.VERSION.SDK_INT >= 24) {
                        try {
                            List<SNIServerName> sniNames = new ArrayList<>();
                            sniNames.add(new SNIHostName(host));
                            sslParams.setServerNames(sniNames);
                        } catch (IllegalArgumentException ignored) {
                            // IP literals do not use SNI, but still require hostname verification.
                        }
                    }
                    sslSocket.setSSLParameters(sslParams);
                    sslSocket.startHandshake();
                    socket = sslSocket;
                } else {
                    socket = new Socket();
                    socket.connect(new InetSocketAddress(host, port), 10000);
                }
                socket.setSoTimeout(0);
                in = new BufferedInputStream(socket.getInputStream());
                out = new BufferedOutputStream(socket.getOutputStream());

                String path = "/api/v1/worker/tunnel?node_id=" + URLEncoder.encode(nodeId, "UTF-8");
                String hostHeader = host + (port != 80 && port != 443 ? (":" + port) : "");
                String handshake = "GET " + path + " HTTP/1.1\r\n" +
                                   "Host: " + hostHeader + "\r\n" +
                                   "Authorization: Bearer " + secret + "\r\n" +
                                   "User-Agent: Mozilla/5.0 (Linux; Android) BYOG-Worker/1.0\r\n" +
                                   "Upgrade: websocket\r\n" +
                                   "Connection: Upgrade\r\n" +
                                   "Sec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\n" +
                                   "Sec-WebSocket-Version: 13\r\n\r\n";
                out.write(handshake.getBytes("UTF-8"));
                out.flush();

                StringBuilder headerBuf = new StringBuilder();
                int prev = 0;
                while (true) {
                    int b = in.read();
                    if (b == -1) break;
                    headerBuf.append((char) b);
                    if (prev == '\r' && b == '\n' && headerBuf.toString().endsWith("\r\n\r\n")) {
                        break;
                    }
                    prev = b;
                }

                if (!headerBuf.toString().contains("101")) {
                    String respHdr = headerBuf.toString();
                    if (respHdr.contains("404") || respHdr.contains("401")) {
                        android.util.Log.w("BYOG_WS", "Tunnel handshake HTTP 404/401, device unlinked");
                        handleDeviceRemoved();
                    }
                    close();
                    return;
                }

                connected = true;
                sendHeartbeatFrame();

                Thread keepaliveThread = new Thread(new Runnable() {
                    @Override
                    public void run() {
                        while (connected && isRunning) {
                            try {
                                Thread.sleep(12000);
                                if (connected && isRunning) {
                                    sendHeartbeatFrame();
                                }
                            } catch (InterruptedException e) {
                                break;
                            } catch (Exception ignored) {}
                        }
                    }
                });
                keepaliveThread.setDaemon(true);
                keepaliveThread.start();

                while (connected && isRunning) {
                    int b0 = in.read();
                    if (b0 == -1) break;
                    int opcode = b0 & 0x0F;
                    int b1 = in.read();
                    if (b1 == -1) break;
                    boolean masked = (b1 & 0x80) != 0;
                    int len = b1 & 0x7F;
                    if (len == 126) {
                        int hi = in.read();
                        int lo = in.read();
                        len = ((hi & 0xFF) << 8) | (lo & 0xFF);
                    } else if (len == 127) {
                        long l = 0;
                        for (int i = 0; i < 8; i++) {
                            l = (l << 8) | (in.read() & 0xFF);
                        }
                        len = (int) l;
                    }
                    byte[] mask = null;
                    if (masked) {
                        mask = new byte[4];
                        readFully(in, mask);
                    }
                    byte[] payload = new byte[len];
                    readFully(in, payload);
                    if (masked && mask != null) {
                        for (int i = 0; i < len; i++) {
                            payload[i] = (byte)(payload[i] ^ mask[i % 4]);
                        }
                    }

                    if (opcode == 8) { // CLOSE
                        android.util.Log.i("BYOG_TUNNEL", "Received CLOSE opcode 8");
                        break;
                    } else if (opcode == 9) { // PING
                        sendPong(payload);
                    } else if (opcode == 1) { // TEXT
                        String msg = new String(payload, "UTF-8");
                        android.util.Log.i("BYOG_TUNNEL", "Received text msg (" + msg.length() + " chars): " + (msg.length() < 200 ? msg : msg.substring(0, 200)));
                        handleTunnelMessage(msg);
                    }
                }
            } catch (Exception ex) {
                android.util.Log.e("BYOG_TUNNEL", "Tunnel read loop exception: " + ex.getMessage(), ex);
            }
            finally {
                close();
            }
        }

        private void readFully(InputStream is, byte[] b) throws Exception {
            int offset = 0;
            while (offset < b.length) {
                int read = is.read(b, offset, b.length - offset);
                if (read == -1) throw new Exception("EOF");
                offset += read;
            }
        }

        public synchronized void sendText(String text) {
            if (!connected || out == null) return;
            try {
                byte[] payload = text.getBytes("UTF-8");
                int len = payload.length;
                ByteArrayOutputStream buf = new ByteArrayOutputStream();
                buf.write(0x81); // FIN + text
                if (len <= 125) {
                    buf.write(0x80 | len);
                } else if (len <= 65535) {
                    buf.write(0x80 | 126);
                    buf.write((len >> 8) & 0xFF);
                    buf.write(len & 0xFF);
                } else {
                    buf.write(0x80 | 127);
                    for (int i = 7; i >= 0; i--) {
                        buf.write((int) ((len >> (8 * i)) & 0xFF));
                    }
                }
                byte[] mask = new byte[4];
                new Random().nextBytes(mask);
                buf.write(mask);
                for (int i = 0; i < len; i++) {
                    buf.write(payload[i] ^ mask[i % 4]);
                }
                out.write(buf.toByteArray());
                out.flush();
            } catch (Exception e) {
                close();
            }
        }

        private synchronized void sendPong(byte[] appData) {
            if (out == null) return;
            try {
                int len = appData != null ? appData.length : 0;
                ByteArrayOutputStream buf = new ByteArrayOutputStream();
                buf.write(0x8A); // FIN + pong
                buf.write(0x80 | len);
                byte[] mask = new byte[4];
                new Random().nextBytes(mask);
                buf.write(mask);
                for (int i = 0; i < len; i++) {
                    buf.write(appData[i] ^ mask[i % 4]);
                }
                out.write(buf.toByteArray());
                out.flush();
            } catch (Exception ignored) {}
        }

        public void sendHeartbeatFrame() {
            try {
                JSONObject payload = new JSONObject();
                // Mobile devices do not expose reliable CPU/GPU sensors to normal apps.
                // Zero means "not measurable" and must not be treated as a real value.
                payload.put("cpu_temp", 0.0);
                payload.put("gpu_temp", 0.0);
                payload.put("battery_temp", getSafeBatteryTemp());
                payload.put("fan_speed", 0);
                payload.put("battery_percent", getSafeBatteryPercent());
                payload.put("is_charging", isSafeCharging());
                payload.put("current_tps", currentLiveTps);
                payload.put("current_ttft_ms", lastTtftMs);
                payload.put("total_tokens", totalTokensProcessed);
                JSONArray inst = new JSONArray();
                for (String m : installedModelsList) inst.put(m);
                payload.put("installed_models", inst);
                payload.put("model_status", currentModelStatus);
                payload.put("downloaded_mb", downloadedMB);
                payload.put("total_mb", totalMB);
                payload.put("download_progress", computeDownloadPercent());
                payload.put("download_status", currentModelStatus);
                // The identity and the live numbers of the transfer: the panel
                // decides with the model id which report is the newer one and
                // the speed and the remaining time give the user the real
                // numbers of the download instead of an estimate.
                String activeDownload = downloadingModel;
                if (activeDownload == null || activeDownload.isEmpty()) {
                    activeDownload = currentAssignedModel;
                }
                payload.put("download_model_id", activeDownload != null ? activeDownload : "");
                payload.put("download_started_at", downloadStartedAtMs);
                payload.put("download_speed_bps", lastDownloadSpeedBps);
                payload.put("eta_seconds", lastDownloadEtaSeconds);
                JSONArray dlq = new JSONArray();
                for (String m : downloadQueueList) dlq.put(m);
                payload.put("download_queue", dlq);
                if (!downloadErrorText.isEmpty()) {
                    payload.put("download_error", downloadErrorText);
                }
                payload.put("active_vram_model", activeVramModel);
                payload.put("is_gamer_mode", false);
                payload.put("is_throttled", false);

                try {
                    java.io.File dataDir = Environment.getDataDirectory();
                    StatFs stat = new StatFs(dataDir.getPath());
                    long bs = stat.getBlockSizeLong();
                    int tGB = (int) Math.max(1, (stat.getBlockCountLong() * bs) / (1024L * 1024L * 1024L));
                    int fGB = (int) Math.max(1, (stat.getAvailableBlocksLong() * bs) / (1024L * 1024L * 1024L));
                    payload.put("total_disk_gb", tGB);
                    payload.put("free_disk_gb", fGB);
                } catch (Exception ignored) {}

                JSONObject frame = new JSONObject();
                frame.put("type", "heartbeat");
                frame.put("payload", payload);
                frame.put("timestamp", System.currentTimeMillis());
                sendText(frame.toString());
            } catch (Exception ignored) {}
        }

        public void close() {
            connected = false;
            try { if (socket != null) socket.close(); } catch (Exception ignored) {}
        }
    }

    private void handleTunnelMessage(String msg) {
        try {
            JSONObject frame = new JSONObject(msg);
            String type = frame.optString("type");
            String id = frame.optString("id");
            android.util.Log.i("BYOG_TUNNEL", "Processing frame type=" + type + " id=" + id);

            if ("ping".equals(type)) {
                JSONObject ack = new JSONObject();
                ack.put("type", "heartbeat_ack");
                ack.put("timestamp", System.currentTimeMillis());
                if (tunnelWs != null) tunnelWs.sendText(ack.toString());
            } else if ("inference_request".equals(type)) {
                JSONObject payload = frame.optJSONObject("payload");
                if (payload == null && frame.has("payload")) {
                    try { payload = new JSONObject(frame.getString("payload")); } catch (Exception ignored) {}
                }
                executeInference(id, payload);
            } else if ("canary_request".equals(type)) {
                JSONObject payload = frame.optJSONObject("payload");
                if (payload == null && frame.has("payload")) {
                    try { payload = new JSONObject(frame.getString("payload")); } catch (Exception ignored) {}
                }
                executeCanary(id, payload);
            } else if ("byte_probe_request".equals(type)) {
                JSONObject payload = frame.optJSONObject("payload");
                if (payload == null && frame.has("payload")) {
                    try { payload = new JSONObject(frame.getString("payload")); } catch (Exception ignored) {}
                }
                respondByteProbe(id, payload);
            } else if ("download_model".equals(type)) {
                JSONObject payload = frame.optJSONObject("payload");
                if (payload == null && frame.has("payload")) {
                    try { payload = new JSONObject(frame.getString("payload")); } catch (Exception ignored) {}
                }
                requestModelDownload(payload);
            } else if ("purge_model".equals(type)) {
                JSONObject payload = frame.optJSONObject("payload");
                if (payload == null && frame.has("payload")) {
                    try { payload = new JSONObject(frame.getString("payload")); } catch (Exception ignored) {}
                }
                purgeModel(payload != null ? payload.optString("model_id", "") : "");
            } else if ("pause_worker".equals(type)) {
                workerPaused = true;
                currentModelStatus = "paused";
            } else if ("resume_worker".equals(type)) {
                workerPaused = false;
                currentModelStatus = downloadQueueList.isEmpty() ? "ready" : "downloading";
            } else if ("device_removed".equals(type) || "pairing_revoked".equals(type)) {
                handleDeviceRemoved();
            } else if ("force_update".equals(type)) {
                SharedPreferences sp = getSharedPreferences("byog_prefs", MODE_PRIVATE);
                String base = stringPref(sp, "server_url", "");
                while (base.endsWith("/")) base = base.substring(0, base.length() - 1);
                if (!base.isEmpty()) {
                    final String serverBase = base;
                    new Thread(new Runnable() {
                        @Override
                        public void run() {
                            downloadAndNotifyUpdate("force", serverBase + "/api/v1/worker/download/android/apk");
                        }
                    }).start();
                }
            }
        } catch (Exception ignored) {}
    }

    /**
     * Server driven model provisioning: the model is queued and downloaded with the very
     * same progress pipeline that is used for the regular assignment queue.
     */
    private void requestModelDownload(JSONObject payload) {
        try {
            if (payload == null) return;
            String modelId = payload.optString("model_id", "");
            if (modelId.isEmpty()) return;
            String url = payload.optString("download_url", "");
            if (!url.isEmpty()) {
                modelDownloadUrls.put(modelId, url);
            }
            long size = payload.optLong("file_size", 0);
            if (size > 0) {
                modelFileSizes.put(modelId, size);
            }
            if (!downloadQueueList.contains(modelId)) {
                downloadQueueList.add(modelId);
            }
            currentAssignedModel = downloadQueueList.isEmpty() ? modelId : downloadQueueList.get(0);
            downloadingModel = currentAssignedModel;
            downloadCurrentBytes = 0;
            downloadTotalBytes = size > 0 ? size : 0;
            downloadedMB = 0;
            totalMB = size > 0 ? (int) (size / (1024 * 1024)) : getModelSizeMB(modelId);
            // A server driven download is a new transfer: the identity of the
            // progress changes and the numbers of the old model do not belong
            // to the new one.
            downloadStartedAtMs = System.currentTimeMillis();
            lastDownloadSpeedBps = 0;
            lastDownloadEtaSeconds = 0;
            lastBroadcastPercent = 0;
            lastBroadcastModel = downloadingModel;
            checkAndTriggerModelDownloads();
        } catch (Exception ignored) {}
    }

    private void purgeModel(String modelId) {
        try {
            if (modelId.isEmpty()) return;
            File f = new File(getFilesDir(), modelId + ".gguf");
            if (f.exists()) {
                f.delete();
            }
            File part = new File(getFilesDir(), modelId + ".gguf.part");
            if (part.exists()) {
                part.delete();
            }
            installedModelsList.remove(modelId);
            downloadQueueList.remove(modelId);
            if (modelId.equals(activeVramModel)) {
                activeVramModel = "";
                LocalNeuralEngine.releaseModel();
            }
            SharedPreferences sp = getSharedPreferences("byog_prefs", MODE_PRIVATE);
            JSONArray arr = new JSONArray();
            for (String m : installedModelsList) arr.put(m);
            sp.edit().putString("installed_models", arr.toString()).apply();
        } catch (Exception ignored) {}
    }

    /**
     * Anti-cheat canary test. The answer is produced by the very same local llama.cpp
     * runtime that serves user traffic - nothing is hard coded.
     */
    private void executeCanary(final String id, final JSONObject payload) {
        new Thread(new Runnable() {
            @Override
            public void run() {
                try {
                    String prompt = payload != null ? payload.optString("prompt", "") : "";
                    if (prompt.isEmpty()) prompt = "2+2=";
                    String modelId = payload != null ? payload.optString("model_id", "") : "";
                    if (modelId.isEmpty()) modelId = currentAssignedModel;
                    int maxTokens = payload != null ? payload.optInt("max_tokens", 32) : 32;

                    // The canary answers with the error frame when the model is
                    // not a sane file on the disk, the native engine must never
                    // see a truncated download.
                    File canaryFile = LocalNeuralEngine.resolveModelFile(getFilesDir(), modelId);
                    String headerProblem = LocalNeuralEngine.validateGgufHeader(canaryFile);
                    if (headerProblem != null) {
                        JSONObject resp = new JSONObject();
                        resp.put("request_id", payload != null ? payload.optString("request_id", id) : id);
                        resp.put("error", "Model dosyasi hazir degil: " + headerProblem);
                        JSONObject frame = new JSONObject();
                        frame.put("type", "canary_response");
                        frame.put("id", id);
                        frame.put("payload", resp);
                        frame.put("timestamp", System.currentTimeMillis());
                        if (tunnelWs != null) tunnelWs.sendText(frame.toString());
                        return;
                    }

                    LocalNeuralEngine engine = new LocalNeuralEngine(modelId, getFilesDir());
                    LocalNeuralEngine.InferenceResult res = engine.generateStream(prompt, maxTokens, 0.1f, 0.92f, null, null);

                    JSONObject resp = new JSONObject();
                    resp.put("request_id", payload != null ? payload.optString("request_id", id) : id);
                    resp.put("total_tokens", res.totalTokens);
                    resp.put("prompt_tokens", res.promptTokens);
                    resp.put("ttft_ms", res.ttftMs);
                    resp.put("tps", res.tps);
                    resp.put("text", res.fullText);
                    resp.put("error", res.error != null ? res.error : "");
                    resp.put("raw_tokens", engine.encode(res.fullText));
                    JSONArray logprobs = new JSONArray();
                    for (Float lp : res.logprobs) {
                        logprobs.put(lp);
                    }
                    resp.put("logprobs", logprobs);

                    JSONObject frame = new JSONObject();
                    frame.put("type", "canary_response");
                    frame.put("id", id);
                    frame.put("payload", resp);
                    frame.put("timestamp", System.currentTimeMillis());
                    if (tunnelWs != null) tunnelWs.sendText(frame.toString());
                } catch (Throwable t) {
                    try {
                        JSONObject resp = new JSONObject();
                        resp.put("request_id", id);
                        resp.put("error", t.getMessage() != null ? t.getMessage() : t.toString());
                        JSONObject frame = new JSONObject();
                        frame.put("type", "canary_response");
                        frame.put("id", id);
                        frame.put("payload", resp);
                        if (tunnelWs != null) tunnelWs.sendText(frame.toString());
                    } catch (Exception ignored) {}
                }
            }
        }).start();
    }

    /**
     * Anti-cheat byte spot check: returns the real bytes of the model file on disk.
     */
    private void respondByteProbe(String id, JSONObject payload) {
        try {
            JSONObject resp = new JSONObject();
            resp.put("request_id", payload != null ? payload.optString("request_id", id) : id);
            String modelId = payload != null ? payload.optString("model_id", "") : "";
            if (modelId.isEmpty()) modelId = currentAssignedModel;
            long offset = payload != null ? payload.optLong("offset", 0) : 0;
            int length = payload != null ? payload.optInt("length", 64) : 64;
            if (length <= 0 || length > 4096) length = 64;

            File f = new File(getFilesDir(), modelId + ".gguf");
            byte[] data = new byte[length];
            int read = 0;
            if (f.exists()) {
                try {
                    java.io.RandomAccessFile raf = new java.io.RandomAccessFile(f, "r");
                    try {
                        raf.seek(offset);
                        read = raf.read(data);
                    } finally {
                        raf.close();
                    }
                } catch (Exception ignored) {}
            }
            if (read < length) {
                for (int i = Math.max(0, read); i < length; i++) {
                    data[i] = 0;
                }
            }
            resp.put("data_hex", toHex(data));
            resp.put("length", length);
            resp.put("offset", offset);
            resp.put("file_size", f.exists() ? f.length() : 0);

            JSONObject frame = new JSONObject();
            frame.put("type", "byte_probe_response");
            frame.put("id", id);
            frame.put("payload", resp);
            frame.put("timestamp", System.currentTimeMillis());
            if (tunnelWs != null) tunnelWs.sendText(frame.toString());
        } catch (Exception ignored) {}
    }

    private static String toHex(byte[] data) {
        StringBuilder sb = new StringBuilder(data.length * 2);
        for (int i = 0; i < data.length; i++) {
            int v = data[i] & 0xFF;
            if (v < 16) sb.append('0');
            sb.append(Integer.toHexString(v));
        }
        return sb.toString();
    }

    /**
     * Reports a crash to the coordinator so the panel can show what happened instead of
     * the device silently disappearing.
     */
    /**
     * Describes a failure with its type and its stack trace.
     */
    static String describe(Throwable failure) {
        if (failure == null) return "bilinmeyen hata";
        StringBuilder text = new StringBuilder();
        text.append(failure.getClass().getSimpleName());
        if (failure.getMessage() != null) {
            text.append(": ").append(failure.getMessage());
        }
        java.io.StringWriter writer = new java.io.StringWriter();
        failure.printStackTrace(new java.io.PrintWriter(writer));
        text.append("\n").append(writer.toString());
        return text.toString();
    }

    void reportCrash(final String errorCode, final String errorMessage, final String stackTrace) {
        try {
            SharedPreferences sp = getSharedPreferences("byog_prefs", MODE_PRIVATE);
            Map<String, ?> identity = sp.getAll();
            final String serverUrl = normalizeServerUrl(snapshotString(identity, "server_url"));
            final String nodeId = snapshotString(identity, "node_id");
            final String workerSecret = snapshotString(identity, "worker_secret");
            if (!isSecureServerURL(serverUrl)) return;
            new Thread(new Runnable() {
                @Override
                public void run() {
                    try {
                        JSONObject body = new JSONObject();
                        body.put("node_id", nodeId);
                        body.put("error_code", errorCode);
                        body.put("error_message", errorMessage);
                        body.put("stack_trace", stackTrace);
                        body.put("model_id", currentAssignedModel);
                        body.put("created_at", System.currentTimeMillis() / 1000);

                        URL url = new URL(serverUrl + "/api/v1/worker/telemetry/crash");
                        HttpURLConnection conn = (HttpURLConnection) url.openConnection();
            conn.setInstanceFollowRedirects(false);
                        conn.setRequestMethod("POST");
                        conn.setRequestProperty("Content-Type", "application/json");
                        conn.setRequestProperty("Authorization", "Bearer " + workerSecret);
                        conn.setConnectTimeout(6000);
                        conn.setReadTimeout(6000);
                        conn.setDoOutput(true);
                        OutputStream os = conn.getOutputStream();
                        os.write(body.toString().getBytes("UTF-8"));
                        os.close();
                        conn.getResponseCode();
                        conn.disconnect();
                    } catch (Throwable ignored) {}
                }
            }).start();
        } catch (Throwable ignored) {}
    }

    /**
     * Reports an inference failure to the coordinator. The server turns this into a
     * proper API error instead of waiting for a timeout.
     */
    private void sendInferenceError(String id, String message) {
        try {
            JSONObject errPayload = new JSONObject();
            errPayload.put("request_id", id);
            errPayload.put("error", message != null ? message : "unknown error");
            JSONObject errFrame = new JSONObject();
            errFrame.put("type", "inference_error");
            errFrame.put("id", id);
            errFrame.put("payload", errPayload);
            errFrame.put("timestamp", System.currentTimeMillis());
            if (tunnelWs != null) tunnelWs.sendText(errFrame.toString());
        } catch (Exception ignored) {}
    }

    private void executeInference(final String id, final JSONObject payload) {
        android.util.Log.i("BYOG_INFERENCE", "executeInference called for id=" + id);
        new Thread(new Runnable() {
            @Override
            public void run() {
                try {
                    String reqModel = payload != null ? payload.optString("model_id", "qwen-2.5-0.5b-instruct") : "qwen-2.5-0.5b-instruct";

                    if (workerPaused) {
                        sendInferenceError(id, "Worker sunucu tarafindan duraklatildi");
                        return;
                    }

                    // The model must be a real file on the disk of the device.
                    // A request for a model that is not downloaded answers with
                    // the error frame at once, the playground shows the reason
                    // instead of waiting for the timeout of the coordinator.
                    File reqFile = LocalNeuralEngine.resolveModelFile(getFilesDir(), reqModel);
                    if (!isValidGGUFFile(reqFile, reqModel)) {
                        installedModelsList.remove(reqModel);
                        if (!downloadQueueList.contains(reqModel)) {
                            downloadQueueList.add(reqModel);
                        }
                        currentAssignedModel = reqModel;
                        currentModelStatus = "downloading";
                        sendInferenceError(id, "Model cihazda hazir degil, indirme sirasina alindi: " + reqModel);
                        checkAndTriggerModelDownloads();
                        return;
                    }

                    // VRAM Hot Swapping:
                    // If requested model is not in VRAM, evict current model and load requested model into VRAM
                    if (!reqModel.equals(activeVramModel)) {
                        activeVramModel = reqModel;
                    }
                    if (!installedModelsList.contains(reqModel)) {
                        installedModelsList.add(reqModel);
                    }

                    currentLiveTps = 0.0f;
                    currentModelStatus = "running";

                    SharedPreferences sp = getSharedPreferences("byog_prefs", MODE_PRIVATE);
                    String appName = sp != null ? stringPref(sp, "app_name", "{app_name}") : "{app_name}";
                    String runningDesc = reqModel + " token üretiyor... (Üretimde)";
                    Notification runningNotif = buildNotification(appName, runningDesc);
                    NotificationManager nm = (NotificationManager) getSystemService(Context.NOTIFICATION_SERVICE);
                    if (nm != null) nm.notify(NOTIF_ID, runningNotif);

                    // Broadcast state to local app UI immediately
                    currentModelStatus = "running";
                    broadcastCurrentState();

                    // Immediately trigger HTTP sync to server coordinator
                    new Thread(new Runnable() { @Override public void run() { doHttpHeartbeatAndSync(runningDesc); } }).start();

                    String userPrompt = "";
                    if (payload != null) {
                        userPrompt = payload.optString("prompt", "");
                        if (userPrompt.isEmpty() && payload.has("messages")) {
                            Object msgsObj = payload.get("messages");
                            if (msgsObj instanceof JSONArray) {
                                JSONArray arr = (JSONArray) msgsObj;
                                if (arr.length() > 0) {
                                    JSONObject lastM = arr.optJSONObject(arr.length() - 1);
                                    if (lastM != null) userPrompt = lastM.optString("content", "");
                                }
                            } else if (msgsObj instanceof String) {
                                try {
                                    JSONArray arr = new JSONArray((String) msgsObj);
                                    if (arr.length() > 0) {
                                        JSONObject lastM = arr.optJSONObject(arr.length() - 1);
                                        if (lastM != null) userPrompt = lastM.optString("content", "");
                                    }
                                } catch (Exception ignored) {}
                            }
                        }
                    }

                    // True On-Device Local Neural Engine Execution (llama.cpp)
                    LocalNeuralEngine engine = new LocalNeuralEngine(reqModel, getFilesDir());
                    int maxTokens = payload != null ? payload.optInt("max_tokens", 512) : 512;
                    float temp = payload != null ? (float) payload.optDouble("temperature", 0.7) : 0.7f;
                    float topP = payload != null ? (float) payload.optDouble("top_p", 0.92) : 0.92f;
                    String[] stopWords = null;
                    if (payload != null && payload.has("stop")) {
                        try {
                            JSONArray stopArr = payload.optJSONArray("stop");
                            if (stopArr != null && stopArr.length() > 0) {
                                stopWords = new String[stopArr.length()];
                                for (int s = 0; s < stopArr.length(); s++) {
                                    stopWords[s] = stopArr.optString(s, "");
                                }
                            }
                        } catch (Exception ignored) {}
                    }

                    final long[] streamStartedAt = new long[]{0};
                    final int[] streamTokenCount = new int[]{0};
                    final long[] lastTelemetryAt = new long[]{0};

                    LocalNeuralEngine.InferenceResult res = engine.generateStream(
                        userPrompt,
                        maxTokens,
                        temp,
                        topP,
                        stopWords,
                        new LocalNeuralEngine.StreamCallback() {
                            @Override
                            public boolean onToken(String piece, int tokenId) {
                                try {
                                    if (streamStartedAt[0] == 0) {
                                        streamStartedAt[0] = System.currentTimeMillis();
                                    }
                                    streamTokenCount[0]++;

                                    JSONObject chunkPayload = new JSONObject();
                                    chunkPayload.put("request_id", id);
                                    chunkPayload.put("content", piece);
                                    chunkPayload.put("token_id", tokenId);
                                    chunkPayload.put("is_final", false);

                                    JSONObject chunkFrame = new JSONObject();
                                    chunkFrame.put("type", "inference_chunk");
                                    chunkFrame.put("id", id);
                                    chunkFrame.put("payload", chunkPayload);
                                    chunkFrame.put("timestamp", System.currentTimeMillis());

                                    if (tunnelWs != null) tunnelWs.sendText(chunkFrame.toString());

                                    // Publish the measured tokens/second while the model is generating.
                                    long now = System.currentTimeMillis();
                                    if (now - lastTelemetryAt[0] > 1500 && streamStartedAt[0] > 0) {
                                        lastTelemetryAt[0] = now;
                                        long elapsed = now - streamStartedAt[0];
                                        if (elapsed > 0) {
                                            currentLiveTps = (float) ((streamTokenCount[0] * 1000.0) / elapsed);
                                            currentLiveTps = Math.round(currentLiveTps * 10.0f) / 10.0f;
                                        }
                                        if (tunnelWs != null) tunnelWs.sendHeartbeatFrame();
                                    }
                                } catch (Exception ignored) {}
                                // A generation without a tunnel produces tokens
                                // for nobody and drains the battery of the
                                // device, the stream stops when the connection
                                // of the coordinator is gone.
                                return isRunning && tunnelWs != null && tunnelWs.connected;
                            }
                        }
                    );

                    if (!res.success) {
                        sendInferenceError(id, res.error != null ? res.error : "Yerel model çalıştırılamadı");
                        currentModelStatus = downloadQueueList.isEmpty() ? "ready" : "downloading";
                        currentLiveTps = 0.0f;
                        if (tunnelWs != null) tunnelWs.sendHeartbeatFrame();
                        doHttpHeartbeatAndSync("Çıkarma hatası: " + (res.error != null ? res.error : "bilinmiyor"));
                        return;
                    }

                    totalTokensProcessed += res.totalTokens;
                    currentLiveTps = res.tps;
                    lastTtftMs = res.ttftMs;

                    // Final chunk so the server can close the stream deterministically.
                    try {
                        JSONObject finalPayload = new JSONObject();
                        finalPayload.put("request_id", id);
                        finalPayload.put("content", "");
                        finalPayload.put("token_id", 1000 + res.totalTokens);
                        finalPayload.put("is_final", true);
                        JSONObject finalFrame = new JSONObject();
                        finalFrame.put("type", "inference_chunk");
                        finalFrame.put("id", id);
                        finalFrame.put("payload", finalPayload);
                        finalFrame.put("timestamp", System.currentTimeMillis());
                        if (tunnelWs != null) tunnelWs.sendText(finalFrame.toString());
                    } catch (Exception ignored) {}

                    // Inference Done Frame
                    JSONObject donePayload = new JSONObject();
                    donePayload.put("request_id", id);
                    donePayload.put("total_tokens", res.totalTokens);
                    donePayload.put("prompt_tokens", res.promptTokens > 0 ? res.promptTokens : Math.max(4, userPrompt.length() / 4));
                    donePayload.put("ttft_ms", res.ttftMs);
                    donePayload.put("tps", res.tps);

                    JSONObject doneFrame = new JSONObject();
                    doneFrame.put("type", "inference_done");
                    doneFrame.put("id", id);
                    doneFrame.put("payload", donePayload);
                    doneFrame.put("timestamp", System.currentTimeMillis());

                    if (tunnelWs != null) tunnelWs.sendText(doneFrame.toString());

                    // Post-Inference VRAM Policy:
                    // If hot_start_enabled: keep model in VRAM
                    // If !hot_start_enabled: unload from VRAM immediately!
                    if (!hotStartEnabled) {
                        activeVramModel = "";
                    }

                    if (sp != null) {
                        sp.edit()
                            .putLong("total_tokens_processed", totalTokensProcessed)
                            .putFloat("last_tps", currentLiveTps)
                            .apply();
                    }

                    currentLiveTps = 0.0f; // Reset to 0 when idle!
                    if (!downloadQueueList.isEmpty()) {
                        currentModelStatus = "downloading";
                    } else {
                        currentModelStatus = "ready";
                    }

                    String statusMsg = (hotStartEnabled && !activeVramModel.isEmpty() ? activeVramModel + (isTurkish() ? " hazır (Bellekte)" : " ready (in Memory)") : reqModel + (isTurkish() ? " hazır (Beklemede)" : " ready (Idle)"));
                    if (!downloadQueueList.isEmpty()) {
                        statusMsg = buildDownloadStatusMessage(downloadQueueList.get(0));
                    }
                    Notification idleNotif = buildNotification(appName, statusMsg);
                    if (nm != null) nm.notify(NOTIF_ID, idleNotif);

                    // Broadcast state to local app UI immediately
                    broadcastCurrentState();

                    // Immediately sync idle status to server
                    doHttpHeartbeatAndSync(statusMsg);
                    if (tunnelWs != null) tunnelWs.sendHeartbeatFrame();

                } catch (Throwable t) {
                    android.util.Log.e("BYOG_INFERENCE", "Inference failed: " + t.getMessage(), t);
                    reportCrash("ERR_INFERENCE", describe(t), "");
                    sendInferenceError(id, t.getMessage() != null ? t.getMessage() : t.toString());
                    currentLiveTps = 0.0f;
                    if (!downloadQueueList.isEmpty()) {
                        currentModelStatus = "downloading";
                    } else {
                        currentModelStatus = "ready";
                    }
                }
            }
        }).start();
    }

    private Notification buildNotification(String ignoredTitle, String statusHint) {
        try {
            SharedPreferences sp = getSharedPreferences("byog_prefs", MODE_PRIVATE);
            String sysName = sp != null ? stringPref(sp, "system_name", "") : "";
            if (sysName.isEmpty()) sysName = sp != null ? stringPref(sp, "app_name", "{app_name}") : "{app_name}";
            boolean isTr = isTurkish();

            // Format status state title according to Item 16
            String statusSuffix;
            String hintLower = statusHint != null ? statusHint.toLowerCase() : "";
            if (hintLower.contains("run") || hintLower.contains("üretim") || hintLower.contains("çalışıyor")) {
                statusSuffix = isTr ? "Çalışıyor" : "Running";
            } else if (hintLower.contains("download") || hintLower.contains("indiriliyor")) {
                statusSuffix = isTr ? "İndiriliyor" : "Downloading";
            } else if (hintLower.contains("stop") || hintLower.contains("durduruldu") || hintLower.contains("kaldırıldı") || hintLower.contains("çevrimdışı") || hintLower.contains("offline")) {
                statusSuffix = isTr ? "Durduruldu" : "Stopped";
            } else if (hintLower.contains("error") || hintLower.contains("hata")) {
                statusSuffix = isTr ? "Hata" : "Error";
            } else {
                statusSuffix = isTr ? "Bekliyor" : "Waiting";
            }

            String titlePrefix = sysName.trim();
            if (titlePrefix.isEmpty() || titlePrefix.equalsIgnoreCase("New API") || titlePrefix.equalsIgnoreCase("BYOG Worker")) titlePrefix = "BYOG";
            String titleLower = titlePrefix.toLowerCase();
            if (titleLower.endsWith("byog worker")) {
                titlePrefix = titlePrefix.substring(0, titlePrefix.length() - 7).trim(); // strip " Worker" -> "{systemName} BYOG"
            } else if (titleLower.endsWith("byog")) {
                // already ends with BYOG
            } else {
                titlePrefix = titlePrefix + " BYOG";
            }
            String notifTitle = titlePrefix + " - " + statusSuffix;

            long totalTokens = sp != null ? sp.getLong("total_tokens_processed", 0) : 0;
            long dailyTokens = sp != null ? sp.getLong("daily_tokens_earned", 0) : 0;

            Notification.Builder builder;
            if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.O) {
                builder = new Notification.Builder(this, CHANNEL_ID);
            } else {
                builder = new Notification.Builder(this);
            }

            int smallIcon = getSafeSmallIcon();
            builder.setContentTitle(notifTitle)
                   .setSmallIcon(smallIcon)
                   .setOngoing(true);

            try {
                if (getApplicationInfo() != null && getApplicationInfo().icon != 0) {
                    Bitmap bmp = BitmapFactory.decodeResource(getResources(), getApplicationInfo().icon);
                    if (bmp != null) builder.setLargeIcon(bmp);
                }
            } catch (Throwable ignored) {}

            if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.LOLLIPOP) {
                builder.setPriority(Notification.PRIORITY_LOW);
            }

            // Honeygain style: collapsed view is slim / compact with no model ID or VRAM
            // Expanded view with BigTextStyle shows total token balance and daily earnings
            String expandedBody = isTr
                ? "Toplam Bakiye: " + String.format(java.util.Locale.US, "%,d", totalTokens) + " token\nBugünkü Kazanç: +" + String.format(java.util.Locale.US, "%,d", dailyTokens) + " token"
                : "Total Balance: " + String.format(java.util.Locale.US, "%,d", totalTokens) + " tokens\nToday's Earnings: +" + String.format(java.util.Locale.US, "%,d", dailyTokens) + " tokens";

            Notification.BigTextStyle bigStyle = new Notification.BigTextStyle();
            bigStyle.setBigContentTitle(notifTitle);
            bigStyle.bigText(expandedBody);
            builder.setStyle(bigStyle);

            try {
                Intent mainIntent = new Intent(this, MainActivity.class);
                mainIntent.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK | Intent.FLAG_ACTIVITY_SINGLE_TOP);
                int flags = PendingIntent.FLAG_UPDATE_CURRENT;
                if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.M) {
                    flags |= PendingIntent.FLAG_IMMUTABLE;
                }
                PendingIntent pi = PendingIntent.getActivity(this, 0, mainIntent, flags);
                builder.setContentIntent(pi);
            } catch (Exception ignored) {}

            Notification notif = builder.build();
            notif.flags |= Notification.FLAG_ONGOING_EVENT | Notification.FLAG_NO_CLEAR;
            return notif;
        } catch (Throwable fallbackErr) {
            int fallbackIcon = getSafeSmallIcon();
            if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.O) {
                return new Notification.Builder(this, CHANNEL_ID)
                        .setContentTitle("BYOG Worker")
                        .setContentText("Aktif")
                        .setSmallIcon(fallbackIcon)
                        .build();
            } else {
                return new Notification.Builder(this)
                        .setContentTitle("BYOG Worker")
                        .setContentText("Aktif")
                        .setSmallIcon(fallbackIcon)
                        .build();
            }
        }
    }

    private void createNotificationChannel() {
        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.O) {
            NotificationChannel channel = new NotificationChannel(
                    CHANNEL_ID,
                    "BYOG Worker Service",
                    NotificationManager.IMPORTANCE_LOW
            );
            channel.setDescription("BYOG arka plan işlem ve durum bildirimleri");
            channel.setSound(null, null);
            channel.enableVibration(false);
            channel.setShowBadge(true);
            NotificationManager manager = (NotificationManager) getSystemService(Context.NOTIFICATION_SERVICE);
            if (manager != null) {
                manager.createNotificationChannel(channel);
            }
        }
    }

    private long lastUpdateCheckAt = 0;
    private void checkWorkerUpdatePeriodic(final String serverUrl) {
        long now = System.currentTimeMillis();
        if (now - lastUpdateCheckAt < 15 * 60 * 1000L) return;
        lastUpdateCheckAt = now;
        new Thread(new Runnable() {
            @Override
            public void run() {
                try {
                    String base = serverUrl;
                    while (base.endsWith("/")) base = base.substring(0, base.length() - 1);
                    URL u = new URL(base + "/api/v1/worker/version");
                    HttpURLConnection conn = (HttpURLConnection) u.openConnection();
                    conn.setConnectTimeout(6000);
                    conn.setReadTimeout(6000);
                    if (conn.getResponseCode() == 200) {
                        BufferedReader br = new BufferedReader(new InputStreamReader(conn.getInputStream()));
                        StringBuilder sb = new StringBuilder();
                        String l;
                        while ((l = br.readLine()) != null) sb.append(l);
                        br.close();
                        JSONObject vObj = new JSONObject(sb.toString());
                        String latestVer = vObj.optString("version", "");
                        if (!latestVer.isEmpty() && isNewerVersion(latestVer, "{app_version}")) {
                            JSONObject dlObj = vObj.optJSONObject("downloads");
                            String apkRel = dlObj != null ? dlObj.optString("android_apk", "") : "";
                            if (!apkRel.isEmpty()) {
                                String apkUrl = apkRel.startsWith("http") ? apkRel : (base + apkRel);
                                downloadAndNotifyUpdate(latestVer, apkUrl);
                            }
                        }
                    }
                    conn.disconnect();
                } catch (Exception ignored) {}
            }
        }).start();
    }

    private static boolean isNewerVersion(String latest, String current) {
        if (latest == null || latest.isEmpty() || latest.equals(current)) return false;
        try {
            String[] lParts = latest.replace("v", "").split("\\.");
            String[] cParts = current.replace("v", "").split("\\.");
            int len = Math.max(lParts.length, cParts.length);
            for (int i = 0; i < len; i++) {
                int lVal = i < lParts.length ? Integer.parseInt(lParts[i].replaceAll("[^0-9]", "")) : 0;
                int cVal = i < cParts.length ? Integer.parseInt(cParts[i].replaceAll("[^0-9]", "")) : 0;
                if (lVal > cVal) return true;
                if (lVal < cVal) return false;
            }
        } catch (Exception e) {
            return latest.compareTo(current) > 0;
        }
        return false;
    }

    private void downloadAndNotifyUpdate(String version, String apkUrl) {
        File target = new File(getCacheDir(), "byog-update.apk");
        File partial = new File(getCacheDir(), "byog-update.apk.part");
        try {
            URL u = new URL(apkUrl);
            HttpURLConnection conn = (HttpURLConnection) u.openConnection();
            conn.setConnectTimeout(10000);
            conn.setReadTimeout(60000);
            if (conn.getResponseCode() == 200) {
                long expected = conn.getContentLength();
                if (partial.exists()) partial.delete();
                InputStream is = conn.getInputStream();
                FileOutputStream fos = new FileOutputStream(partial);
                byte[] buf = new byte[65536];
                int n;
                long total = 0;
                while ((n = is.read(buf)) != -1) {
                    fos.write(buf, 0, n);
                    total += n;
                }
                fos.close();
                is.close();
                if (total <= 0 || (expected > 0 && total != expected)) {
                    partial.delete();
                    conn.disconnect();
                    return;
                }
                if (target.exists()) target.delete();
                if (!partial.renameTo(target)) {
                    conn.disconnect();
                    return;
                }

                Intent uIntent = new Intent("org.byog.worker.UPDATE_AVAILABLE");
                uIntent.putExtra("version", version);
                uIntent.putExtra("apk_path", target.getAbsolutePath());
                uIntent.setPackage(getPackageName());
                sendBroadcast(uIntent);

                SharedPreferences sp = getSharedPreferences("byog_prefs", MODE_PRIVATE);
                String appName = sp != null ? stringPref(sp, "app_name", "{app_name}") : "{app_name}";
                Notification updatedNotif = buildNotification(appName, "Yeni Güncelleme İndirildi (" + version + ") - Yüklemek için dokunun");
                NotificationManager nm = (NotificationManager) getSystemService(Context.NOTIFICATION_SERVICE);
                if (nm != null) nm.notify(NOTIF_ID, updatedNotif);
            }
            conn.disconnect();
        } catch (Exception ignored) {}
    }

    

    @Override
    public void onDestroy() {
        isRunning = false;
        if (workerThread != null) workerThread.interrupt();
        if (tunnelThread != null) tunnelThread.interrupt();
        if (tunnelWs != null) tunnelWs.close();
        if (wakeLock != null && wakeLock.isHeld()) wakeLock.release();
        if (wifiLock != null && wifiLock.isHeld()) wifiLock.release();

        try {
            SharedPreferences sp = getSharedPreferences("byog_prefs", MODE_PRIVATE);
            boolean isPaired = sp != null && boolPref(sp, "is_paired", false) && !stringPref(sp, "node_id", "").isEmpty();
            boolean intentional = sp != null && boolPref(sp, "intentional_stop", false);
            if (isPaired && !intentional) {
                Intent restartServiceIntent = new Intent(getApplicationContext(), WorkerService.class);
                restartServiceIntent.setPackage(getPackageName());
                PendingIntent pi = PendingIntent.getService(
                    getApplicationContext(), 2, restartServiceIntent,
                    PendingIntent.FLAG_ONE_SHOT | (Build.VERSION.SDK_INT >= Build.VERSION_CODES.M ? PendingIntent.FLAG_IMMUTABLE : 0)
                );
                AlarmManager am = (AlarmManager) getApplicationContext().getSystemService(Context.ALARM_SERVICE);
                scheduleAlarmCompat(am, SystemClock.elapsedRealtime() + 500, pi);
                Intent bIntent = new Intent("org.byog.worker.RESTART_SERVICE");
                bIntent.setPackage(getPackageName());
                sendBroadcast(bIntent);
            }
        } catch (Throwable ignored) {}
        super.onDestroy();
    }

