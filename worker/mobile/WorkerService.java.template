    @Override
    public void onCreate() {
        super.onCreate();
        try {
            if (getApplicationInfo() != null && getApplicationInfo().nativeLibraryDir != null) {
                System.setProperty("de.kherud.llama.lib.path", getApplicationInfo().nativeLibraryDir);
                android.util.Log.i("BYOG_NATIVE", "Set de.kherud.llama.lib.path to " + getApplicationInfo().nativeLibraryDir);
            }
        } catch (Throwable ignored) {}
        installWorkerCrashHandler();
        createNotificationChannel();
        SharedPreferences sp = getSharedPreferences("byog_prefs", MODE_PRIVATE);
        String appName = sp != null ? stringPref(sp, "app_name", "{app_name}") : "{app_name}";
        Notification notification = buildNotification(appName, "BYOG Servisi aktif...");
        try {
            if (Build.VERSION.SDK_INT >= 29) {
                startForeground(NOTIF_ID, notification, ServiceInfo.FOREGROUND_SERVICE_TYPE_DATA_SYNC);
            } else {
                startForeground(NOTIF_ID, notification);
            }
        } catch (Exception e) {
            try {
                startForeground(NOTIF_ID, notification);
            } catch (Exception ignored) {}
        }
    }

    @Override
    public int onStartCommand(Intent intent, int flags, int startId) {
        try {
            SharedPreferences sp = getSharedPreferences("byog_prefs", MODE_PRIVATE);
            String appName = sp != null ? stringPref(sp, "app_name", "{app_name}") : "{app_name}";
            Notification notification = buildNotification(appName, "BYOG Servisi aktif...");
            try {
                if (Build.VERSION.SDK_INT >= 29) {
                    startForeground(NOTIF_ID, notification, ServiceInfo.FOREGROUND_SERVICE_TYPE_DATA_SYNC);
                } else {
                    startForeground(NOTIF_ID, notification);
                }
            } catch (Throwable ignored) {}
            return runWorker(intent, flags, startId);
        } catch (Throwable failure) {
            reportCrash("ERR_WORKER_START", describe(failure), "");
            return START_STICKY;
        }
    }

    private int runWorker(Intent intent, int flags, int startId) {
        SharedPreferences sp = getSharedPreferences("byog_prefs", MODE_PRIVATE);
        boolean isPaired = sp != null && boolPref(sp, "is_paired", false) && !stringPref(sp, "node_id", "").isEmpty();
        if (!isPaired) {
            try {
                if (Build.VERSION.SDK_INT >= 24) {
                    stopForeground(STOP_FOREGROUND_REMOVE);
                } else {
                    stopForeground(true);
                }
            } catch (Exception ignored) {}
            stopSelf();
            return START_NOT_STICKY;
        }

        if (isRunning) {
            // The activity asks for the current state as soon as it becomes visible.
            if (intent != null && "refresh_state".equals(intent.getStringExtra("action"))) {
                broadcastCurrentState();
            }
            return START_STICKY;
        }
        isRunning = true;

        currentAssignedModel = stringPref(sp, "assigned_model", "qwen-2.5-0.5b-instruct");
        activeVramModel = stringPref(sp, "active_vram_model", "");
        hotStartEnabled = boolPref(sp, "hot_start_enabled", false);
        allocatedDiskGB = intPref(sp, "allocated_disk_gb", 40);
        totalTokensProcessed = sp.getLong("total_tokens_processed", 0);
        downloadedMB = intPref(sp, "downloaded_mb", 0);
        totalMB = intPref(sp, "total_mb", getModelSizeMB(currentAssignedModel));
        if (totalMB <= 0) totalMB = getModelSizeMB(currentAssignedModel);
        downloadingModel = stringPref(sp, "downloading_model", "");
        downloadCurrentBytes = sp.getLong("download_current_bytes", 0);
        downloadTotalBytes = sp.getLong("download_total_bytes", 0);
        downloadErrorText = stringPref(sp, "download_error", "");
        if (downloadTotalBytes > 0) {
            totalMB = (int) (downloadTotalBytes / (1024 * 1024));
            if (totalMB <= 0) totalMB = 1;
        }

        try {
            String instJson = stringPref(sp, "installed_models", "[]");
            JSONArray arr = new JSONArray(instJson);
            installedModelsList.clear();
            for (int i = 0; i < arr.length(); i++) {
                String m = arr.getString(i);
                if (!installedModelsList.contains(m)) installedModelsList.add(m);
            }
        } catch (Exception ignored) {}

        File actualFile = new File(getFilesDir(), currentAssignedModel + ".gguf");
        if (!actualFile.exists() || actualFile.length() < 10L * 1024 * 1024) {
            File sd = new File("/sdcard", currentAssignedModel + ".gguf");
            if (sd.exists() && sd.length() >= 10L * 1024 * 1024) actualFile = sd;
        }
        boolean modelFileOnDisk = actualFile.exists() && actualFile.length() > MIN_MODEL_BYTES;
        if (!modelFileOnDisk) {
            installedModelsList.remove(currentAssignedModel);
        }

        String appName = stringPref(sp, "app_name", "{app_name}");
        String initialMsg;

        if (!modelFileOnDisk || installedModelsList.isEmpty()) {
            if (!downloadQueueList.contains(currentAssignedModel)) {
                downloadQueueList.add(currentAssignedModel);
            }
            currentModelStatus = "downloading";
            currentLiveTps = 0.0f;
            initialMsg = currentAssignedModel + " indiriliyor... (" + downloadedMB + " MB / " + totalMB + " MB - %" + computeDownloadPercent() + ")";
        } else {
            currentModelStatus = "ready";
            currentLiveTps = 0.0f;
            if (hotStartEnabled && activeVramModel.isEmpty()) {
                activeVramModel = installedModelsList.get(0);
            }
            String readyModel = installedModelsList.isEmpty() ? currentAssignedModel : installedModelsList.get(0);
            initialMsg = (!activeVramModel.isEmpty() ? activeVramModel + " hazır (VRAM'de)" : readyModel + " hazır (Beklemede)");
        }

        sp.edit()
            .putString("model_status", currentModelStatus)
            .putString("model_status_desc", initialMsg)
            .putInt("downloaded_mb", downloadedMB)
            .putInt("total_mb", totalMB)
            .apply();

        try {
            JSONObject s = new JSONObject();
            s.put("is_paired", true);
            s.put("model_status", currentModelStatus);
            s.put("model_status_desc", initialMsg);
            s.put("downloaded_mb", downloadedMB);
            s.put("total_mb", totalMB);
            s.put("download_progress", computeDownloadPercent());
            s.put("current_tps", 0.0);
            s.put("active_vram_model", activeVramModel);
            Intent b = new Intent("org.byog.worker.STATE_CHANGED");
            b.putExtra("state", s.toString());
            b.setPackage(getPackageName());
            sendBroadcast(b);
        } catch (Exception ignored) {}

        Notification notification = buildNotification(appName, initialMsg);
        try {
            NotificationManager nm = (NotificationManager) getSystemService(Context.NOTIFICATION_SERVICE);
            if (nm != null) nm.notify(NOTIF_ID, notification);
        } catch (Exception ignored) {}

        acquireLocks();
        startTunnelLoop();
        startWorkerLoop();

        if (!modelFileOnDisk || !downloadQueueList.isEmpty()) {
            checkAndTriggerModelDownloads();
        }

        return START_STICKY;
    }



    /**
     * Reads a boolean of the settings.
     *
     * A value of another type must not end the application. A setting of an
     * earlier version of the application can hold a text, the value is read as
     * a text in that case.
     */
    public static boolean boolPref(SharedPreferences sp, String key, boolean fallback) {
        if (sp == null) return fallback;
        try {
            return sp.getBoolean(key, fallback);
        } catch (ClassCastException e) {
            try {
                return Boolean.parseBoolean(sp.getString(key, String.valueOf(fallback)));
            } catch (Exception ignored) {
                return fallback;
            }
        }
    }

    /**
     * Reads a number of the settings, a value of another type is ignored.
     */
    public static int intPref(SharedPreferences sp, String key, int fallback) {
        if (sp == null) return fallback;
        try {
            return sp.getInt(key, fallback);
        } catch (ClassCastException e) {
            try {
                return Integer.parseInt(sp.getString(key, String.valueOf(fallback)).trim());
            } catch (Exception ignored) {
                return fallback;
            }
        }
    }

    /**
     * Reads a long of the settings, a value of another type is ignored.
     */
    public static long longPref(SharedPreferences sp, String key, long fallback) {
        if (sp == null) return fallback;
        try {
            return sp.getLong(key, fallback);
        } catch (ClassCastException e) {
            try {
                return Long.parseLong(sp.getString(key, String.valueOf(fallback)).trim());
            } catch (Exception ignored) {
                return fallback;
            }
        }
    }

    /**
     * Reads a text of the settings, a value of another type is ignored.
     */
    public static String normalizeServerUrl(String url) {
        if (url == null) return "";
        url = url.trim();
        while (url.endsWith("/")) url = url.substring(0, url.length() - 1);
        boolean isEmu = Build.FINGERPRINT.startsWith("generic")
            || Build.FINGERPRINT.startsWith("unknown")
            || Build.MODEL.contains("google_sdk")
            || Build.MODEL.contains("Emulator")
            || Build.MODEL.contains("Android SDK built for x86")
            || Build.HARDWARE.contains("goldfish")
            || Build.HARDWARE.contains("ranchu");
        if (isEmu) {
            url = url.replace("://10.0.2.2", "://127.0.0.1").replace("://localhost", "://127.0.0.1");
        }
        return url;
    }

    /**
     * Reads a text of the settings, a value of another type is ignored.
     */
    public static String stringPref(SharedPreferences sp, String key, String fallback) {
        if (sp == null) return fallback;
        try {
            String val = sp.getString(key, fallback);
            if ("server_url".equals(key) && val != null) {
                return normalizeServerUrl(val);
            }
            return val;
        } catch (ClassCastException e) {
            return fallback;
        }
    }

    /**
     * Installs the handler for the failures of the threads of the worker.
     *
     * Without a handler of its own, a failure of a thread ends the whole
     * application. The failure is reported to the coordinator instead, the
     * worker keeps running.
     */
    private void installWorkerCrashHandler() {
        try {
            Thread.setDefaultUncaughtExceptionHandler(new Thread.UncaughtExceptionHandler() {
                @Override
                public void uncaughtException(Thread t, Throwable e) {
                    try {
                        android.util.Log.e("BYOG_CRASH", "Worker thread " + t.getName() + " failed", e);
                        reportCrash("ERR_WORKER_THREAD", describe(e), "");
                    } catch (Throwable ignored) {}
                }
            });
        } catch (Throwable ignored) {}
    }

    /**
     * Handles the removal of the device from the network. The pairing is dropped, the
     * interface asks for a new pairing code and the device stops the worker.
     */
    private void handleDeviceRemoved() {
        try {
            SharedPreferences sp = getSharedPreferences("byog_prefs", MODE_PRIVATE);
            sp.edit()
                    .putBoolean("is_paired", false)
                    .putString("node_id", "")
                    .putString("pairing_code", "")
                    .putString("device_removed_message", "Cihaz kaldırıldı")
                    .apply();

            try {
                JSONObject state = new JSONObject();
                state.put("is_paired", false);
                state.put("device_removed", true);
                state.put("message", "Cihaz kaldırıldı");
                Intent bIntent = new Intent("org.byog.worker.STATE_CHANGED");
                bIntent.putExtra("state", state.toString());
                bIntent.setPackage(getPackageName());
                sendBroadcast(bIntent);
            } catch (Exception ignored) {}

            String appName = stringPref(sp, "app_name", "{app_name}");
            Notification removed = buildNotification(appName, "Cihaz kaldırıldı - yeniden eşleştirme gerekiyor");
            NotificationManager nm = (NotificationManager) getSystemService(Context.NOTIFICATION_SERVICE);
            if (nm != null) nm.notify(NOTIF_ID, removed);
        } catch (Exception ignored) {}
        stopSelf();
    }

