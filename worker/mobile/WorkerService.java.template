    @Override
    public void onCreate() {
        super.onCreate();
        // The foreground promotion is the first action of the service. Android
        // gives a started foreground service only seconds of time for the call
        // of startForeground, every step before it (the settings, the branding,
        // the icon) eats that budget and an aggressive system ends the
        // application with the "did not then call Service.startForeground"
        // failure. Nothing heavy runs before the promotion.
        createNotificationChannel();
        Notification notification;
        try {
            SharedPreferences sp = getSharedPreferences("byog_prefs", MODE_PRIVATE);
            String appName = sp != null ? stringPref(sp, "app_name", "{app_name}") : "{app_name}";
            notification = buildNotification(appName, "BYOG Servisi aktif...");
        } catch (Throwable ignored) {
            notification = buildFallbackNotification();
        }
        boolean promoted = false;
        if (Build.VERSION.SDK_INT >= 34) {
            try {
                startForeground(NOTIF_ID, notification, ServiceInfo.FOREGROUND_SERVICE_TYPE_DATA_SYNC | ServiceInfo.FOREGROUND_SERVICE_TYPE_SPECIAL_USE);
                promoted = true;
            } catch (Throwable t0) {
                try {
                    startForeground(NOTIF_ID, notification, ServiceInfo.FOREGROUND_SERVICE_TYPE_SPECIAL_USE);
                    promoted = true;
                } catch (Throwable t1) {
                    try {
                        startForeground(NOTIF_ID, notification, ServiceInfo.FOREGROUND_SERVICE_TYPE_DATA_SYNC);
                        promoted = true;
                    } catch (Throwable t2) {
                        try {
                            startForeground(NOTIF_ID, notification);
                            promoted = true;
                        } catch (Throwable t3) {
                            android.util.Log.e("BYOG_WORKER", "startForeground failed with all types: " + t3.getMessage());
                        }
                    }
                }
            }
        } else if (Build.VERSION.SDK_INT >= 29) {
            try {
                startForeground(NOTIF_ID, notification, ServiceInfo.FOREGROUND_SERVICE_TYPE_DATA_SYNC);
                promoted = true;
            } catch (Throwable t) {
                try {
                    startForeground(NOTIF_ID, notification);
                    promoted = true;
                } catch (Throwable ignored) {}
            }
        } else {
            try {
                startForeground(NOTIF_ID, notification);
                promoted = true;
            } catch (Throwable ignored) {}
        }
        if (!promoted) {
            try {
                Notification safeNotif = buildFallbackNotification();
                if (Build.VERSION.SDK_INT >= 34) {
                    startForeground(NOTIF_ID, safeNotif, ServiceInfo.FOREGROUND_SERVICE_TYPE_DATA_SYNC);
                } else if (Build.VERSION.SDK_INT >= 29) {
                    startForeground(NOTIF_ID, safeNotif, ServiceInfo.FOREGROUND_SERVICE_TYPE_DATA_SYNC);
                } else {
                    startForeground(NOTIF_ID, safeNotif);
                }
                promoted = true;
            } catch (Throwable t) {
                android.util.Log.e("BYOG_WORKER", "Fallback startForeground also failed: " + t.getMessage());
            }
        }
        try {
            if (getApplicationInfo() != null && getApplicationInfo().nativeLibraryDir != null) {
                System.setProperty("de.kherud.llama.lib.path", getApplicationInfo().nativeLibraryDir);
                android.util.Log.i("BYOG_NATIVE", "Set de.kherud.llama.lib.path to " + getApplicationInfo().nativeLibraryDir);
            }
        } catch (Throwable ignored) {}
        installWorkerCrashHandler();
    }

    /** A minimal notification for the case that the branding cannot be read. */
    private Notification buildFallbackNotification() {
        try {
            int icon = getSafeSmallIcon();
            if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.O) {
                createNotificationChannel();
                return new Notification.Builder(this, CHANNEL_ID)
                        .setContentTitle("BYOG")
                        .setContentText("Aktif")
                        .setSmallIcon(icon)
                        .build();
            }
            return new Notification.Builder(this)
                    .setContentTitle("BYOG")
                    .setContentText("Aktif")
                    .setSmallIcon(icon)
                    .build();
        } catch (Throwable ignored) {
            if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.O) {
                return new Notification.Builder(this, CHANNEL_ID)
                        .setSmallIcon(android.R.drawable.stat_notify_sync)
                        .build();
            }
            return new Notification.Builder(this)
                    .setSmallIcon(android.R.drawable.stat_notify_sync)
                    .build();
        }
    }

    @Override
    public int onStartCommand(Intent intent, int flags, int startId) {
        try {
            SharedPreferences sp = getSharedPreferences("byog_prefs", MODE_PRIVATE);
            String appName = sp != null ? stringPref(sp, "app_name", "{app_name}") : "{app_name}";
            Notification notification = buildNotification(appName, "BYOG Servisi aktif...");
            try {
                if (Build.VERSION.SDK_INT >= 34) {
                    try {
                        startForeground(NOTIF_ID, notification, ServiceInfo.FOREGROUND_SERVICE_TYPE_DATA_SYNC | ServiceInfo.FOREGROUND_SERVICE_TYPE_SPECIAL_USE);
                    } catch (Throwable e0) {
                        try {
                            startForeground(NOTIF_ID, notification, ServiceInfo.FOREGROUND_SERVICE_TYPE_SPECIAL_USE);
                        } catch (Throwable e1) {
                            try {
                                startForeground(NOTIF_ID, notification, ServiceInfo.FOREGROUND_SERVICE_TYPE_DATA_SYNC);
                            } catch (Throwable e2) {
                                startForeground(NOTIF_ID, notification);
                            }
                        }
                    }
                } else if (Build.VERSION.SDK_INT >= 29) {
                    startForeground(NOTIF_ID, notification, ServiceInfo.FOREGROUND_SERVICE_TYPE_DATA_SYNC);
                } else {
                    startForeground(NOTIF_ID, notification);
                }
            } catch (Throwable ignored) {}
            return runWorker(intent, flags, startId);
        } catch (Throwable failure) {
            reportCrash("ERR_WORKER_START", describe(failure), "");
            return START_STICKY;
        }
    }

    private int runWorker(Intent intent, int flags, int startId) {
        SharedPreferences sp = getSharedPreferences("byog_prefs", MODE_PRIVATE);
        boolean isPaired = sp != null && boolPref(sp, "is_paired", false) && !stringPref(sp, "node_id", "").isEmpty();
        if (!isPaired) {
            try {
                if (Build.VERSION.SDK_INT >= 24) {
                    stopForeground(STOP_FOREGROUND_REMOVE);
                } else {
                    stopForeground(true);
                }
            } catch (Exception ignored) {}
            stopSelf();
            return START_NOT_STICKY;
        }

        if (isRunning) {
            // The activity asks for the current state as soon as it becomes visible.
            if (intent != null && "refresh_state".equals(intent.getStringExtra("action"))) {
                broadcastCurrentState();
            }
            return START_STICKY;
        }
        isRunning = true;

        currentAssignedModel = stringPref(sp, "assigned_model", "qwen-2.5-0.5b-instruct");
        activeVramModel = stringPref(sp, "active_vram_model", "");
        hotStartEnabled = boolPref(sp, "hot_start_enabled", false);
        if (!hotStartEnabled) {
            activeVramModel = "";
            sp.edit().putString("active_vram_model", "").apply();
        }
        allocatedDiskGB = intPref(sp, "allocated_disk_gb", 40);
        totalTokensProcessed = sp.getLong("total_tokens_processed", 0);
        downloadedMB = intPref(sp, "downloaded_mb", 0);
        totalMB = intPref(sp, "total_mb", getModelSizeMB(currentAssignedModel));
        if (totalMB <= 0) totalMB = getModelSizeMB(currentAssignedModel);
        downloadingModel = stringPref(sp, "downloading_model", "");
        downloadCurrentBytes = sp.getLong("download_current_bytes", 0);
        downloadTotalBytes = sp.getLong("download_total_bytes", 0);
        downloadErrorText = stringPref(sp, "download_error", "");
        if (downloadTotalBytes > 0) {
            totalMB = (int) (downloadTotalBytes / (1024 * 1024));
            if (totalMB <= 0) totalMB = 1;
        }

        try {
            String instJson = stringPref(sp, "installed_models", "[]");
            JSONArray arr = new JSONArray(instJson);
            installedModelsList.clear();
            for (int i = 0; i < arr.length(); i++) {
                String m = arr.getString(i);
                if (!installedModelsList.contains(m)) installedModelsList.add(m);
            }
        } catch (Exception ignored) {}

        File actualFile = new File(getFilesDir(), currentAssignedModel + ".gguf");
        try {
            if (!actualFile.exists() || !isValidGGUFFile(actualFile, currentAssignedModel)) {
                File sd = new File("/sdcard", currentAssignedModel + ".gguf");
                if (sd.exists() && isValidGGUFFile(sd, currentAssignedModel)) actualFile = sd;
            }
        } catch (Throwable ignored) {}
        boolean modelFileOnDisk = isValidGGUFFile(actualFile, currentAssignedModel);
        if (!modelFileOnDisk) {
            installedModelsList.remove(currentAssignedModel);
        }

        String appName = stringPref(sp, "app_name", "{app_name}");
        String initialMsg;

        if (!modelFileOnDisk || installedModelsList.isEmpty()) {
            if (!downloadQueueList.contains(currentAssignedModel)) {
                downloadQueueList.add(currentAssignedModel);
            }
            currentModelStatus = "downloading";
            currentLiveTps = 0.0f;
            int pct = computeDownloadPercent();
            initialMsg = isTurkish()
                ? currentAssignedModel + " indiriliyor... (" + downloadedMB + " MB / " + totalMB + " MB - %" + pct + ")"
                : "Downloading " + currentAssignedModel + "... (" + downloadedMB + " MB / " + totalMB + " MB - " + pct + "%)";
        } else {
            currentModelStatus = "ready";
            currentLiveTps = 0.0f;
            if (hotStartEnabled && activeVramModel.isEmpty() && !installedModelsList.isEmpty()) {
                activeVramModel = installedModelsList.get(0);
            }
            String readyModel = installedModelsList.isEmpty() ? currentAssignedModel : installedModelsList.get(0);
            if (isTurkish()) {
                initialMsg = (hotStartEnabled && !activeVramModel.isEmpty() ? activeVramModel + " hazır (Bellekte)" : readyModel + " hazır (Beklemede)");
            } else {
                initialMsg = (hotStartEnabled && !activeVramModel.isEmpty() ? activeVramModel + " ready (in Memory)" : readyModel + " ready (Idle)");
            }
        }

        sp.edit()
            .putString("model_status", currentModelStatus)
            .putString("model_status_desc", initialMsg)
            .putInt("downloaded_mb", downloadedMB)
            .putInt("total_mb", totalMB)
            .apply();

        broadcastCurrentState();

        Notification notification = buildNotification(appName, initialMsg);
        try {
            NotificationManager nm = (NotificationManager) getSystemService(Context.NOTIFICATION_SERVICE);
            if (nm != null) nm.notify(NOTIF_ID, notification);
        } catch (Exception ignored) {}

        acquireLocks();
        startTunnelLoop();
        startWorkerLoop();

        // The model check and the download start run on the first tick of the
        // worker loop. The start of a download resolves the file of the model
        // and can copy a model of many gigabytes from the storage of the
        // device, that work must never run on the main thread: an ANR of the
        // main thread ends the application on an aggressive system before the
        // service is even paired.
        return START_STICKY;
    }



    /**
     * Reads a boolean of the settings.
     *
     * A value of another type must not end the application. A setting of an
     * earlier version of the application can hold a text, the value is read as
     * a text in that case.
     */
    public static boolean boolPref(SharedPreferences sp, String key, boolean fallback) {
        if (sp == null) return fallback;
        try {
            return sp.getBoolean(key, fallback);
        } catch (ClassCastException e) {
            try {
                return Boolean.parseBoolean(sp.getString(key, String.valueOf(fallback)));
            } catch (Exception ignored) {
                return fallback;
            }
        }
    }

