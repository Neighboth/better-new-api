package org.byog.worker;

import android.util.Log;

import java.io.File;
import java.util.ArrayList;
import java.util.List;

import de.kherud.llama.InferenceParameters;
import de.kherud.llama.LlamaModel;
import de.kherud.llama.LlamaOutput;
import de.kherud.llama.ModelParameters;
import de.kherud.llama.Pair;

/**
 * On-device GGUF inference engine backed by llama.cpp (de.kherud.llama Android bindings).
 *
 * The engine loads the real model weights from the device filesystem and streams
 * genuine tokens produced by the llama.cpp sampler. No canned/template answers are
 * ever produced: when the runtime or the weights are unavailable the caller receives
 * an explicit error instead of fabricated content.
 */
public class LocalNeuralEngine {
    private static final String TAG = "BYOG_ENGINE";
    private static final long MIN_MODEL_BYTES = 200L * 1024 * 1024;

    private static final Object MODEL_LOCK = new Object();
    private static LlamaModel cachedModel = null;
    private static String cachedModelKey = null;

    /**
     * The generations of the device run one at a time.
     *
     * The native engine of llama.cpp is not safe for two concurrent
     * generations of the same loaded model, the anti cheat canary and a
     * request of the playground that arrive at the same moment end the
     * process with a native failure. The lock serializes the generations,
     * the second request waits for the first one instead of crashing the
     * device.
     */
    private static final Object INFERENCE_LOCK = new Object();

    /** The longest generation the device accepts, a huge token count of a request must not block the worker for hours. */
    private static final int MAX_TOKENS_LIMIT = 2048;

    static {
        try {
            android.system.Os.setenv("OMP_NUM_THREADS", "1", true);
        } catch (Throwable ignored) {}
        try {
            System.loadLibrary("c++_shared");
        } catch (Throwable t) {
            Log.w(TAG, "Failed to load c++_shared: " + t.getMessage());
        }
        try {
            System.loadLibrary("omp");
        } catch (Throwable t) {
            Log.w(TAG, "Failed to load omp: " + t.getMessage());
        }
        try {
            System.loadLibrary("jllama");
        } catch (Throwable t) {
            Log.w(TAG, "Failed to load jllama: " + t.getMessage());
        }
    }

    private final String modelId;
    private final File modelFile;

    public interface StreamCallback {
        /** @return false to stop generation */
        boolean onToken(String piece, int tokenId);
    }

    public static class InferenceResult {
        public String fullText = "";
        public int totalTokens = 0;
        public int promptTokens = 0;
        public int ttftMs = 0;
        public float tps = 0.0f;
        public String error = null;
        public boolean success = false;
        /** Log probability of every produced token (used by the anti-cheat canary). */
        public final List<Float> logprobs = new ArrayList<Float>();
    }

    /** Mutable generation counters shared between the retry paths. */
    private static final class GenerationState {
        int tokenCount = 0;
        long firstTokenAt = 0;
        final StringBuilder text = new StringBuilder();
        final List<Float> logprobs = new ArrayList<Float>();
    }

    /**
     * Tokenizes a text with the loaded model vocabulary.
     */
    public int[] encode(String text) {
        try {
            if (modelFile == null || !modelFile.exists()) {
                return new int[0];
            }
            return acquireModel(modelFile).encode(text);
        } catch (Throwable ignored) {
            return new int[0];
        }
    }

    /** Memory the device needs beside the weights: the runtime, the app heap and the compute buffers. */
    private static final long LOAD_RESERVE_BYTES = 768L * 1024L * 1024L;

    /**
     * Why the native engine must not load this model on this device, or null.
     *
     * llama.cpp does not raise a Java exception when the weights do not fit:
     * a failed allocation inside the native library ends the process with an
     * abort, the uncaught exception handler of the application never runs and
     * the tablet dies again on every start (Honor Pad 10 / MagicOS 9). The
     * guard keeps a model that cannot fit out of the engine, the worker
     * reports the reason to the coordinator instead of crashing the device.
     */
    public static String unloadableReason(android.content.Context ctx, File modelFile) {
        try {
            if (ctx == null || modelFile == null || !modelFile.exists()) {
                return null;
            }
            long size = modelFile.length();
            if (size <= 0) {
                return null;
            }
            long budget = weightBudget(ctx);
            if (budget <= 0) {
                return null;
            }
            if (size + LOAD_RESERVE_BYTES > budget) {
                return "Cihazin bellegi bu model icin yetersiz: model "
                        + (size / (1024L * 1024L)) + " MB, cihazin izin verdigi en fazla "
                        + (budget / (1024L * 1024L)) + " MB. Daha kucuk bir model secin.";
            }
            return null;
        } catch (Throwable ignored) {
            return null;
        }
    }

    /** The part of the RAM the weights of a model may occupy on this device. */
    private static long weightBudget(android.content.Context ctx) {
        try {
            android.app.ActivityManager am = (android.app.ActivityManager)
                    ctx.getSystemService(android.content.Context.ACTIVITY_SERVICE);
            if (am == null) {
                return 0L;
            }
            android.app.ActivityManager.MemoryInfo mi = new android.app.ActivityManager.MemoryInfo();
            am.getMemoryInfo(mi);
            if (mi.totalMem <= 0) {
                return 0L;
            }
            return (long) (mi.totalMem * 0.80);
        } catch (Throwable ignored) {
            return 0L;
        }
    }

    public static File resolveModelFile(File modelDir, String modelId) {
        File primary = new File(modelDir, modelId + ".gguf");
        try {
            if (primary.exists() && primary.length() >= MIN_MODEL_BYTES) return primary;
        } catch (Throwable ignored) {}

        File[] candidates = new File[] {
            new File("/sdcard/Android/data/org.byog.worker/files", modelId + ".gguf"),
            new File("/storage/emulated/0/Android/data/org.byog.worker/files", modelId + ".gguf"),
            new File("/sdcard/Download", modelId + ".gguf"),
            new File("/sdcard", modelId + ".gguf"),
            new File("/storage/emulated/0", modelId + ".gguf")
        };

        try {
            for (File cand : candidates) {
                try {
                    if (cand != null && cand.exists() && cand.length() >= MIN_MODEL_BYTES) {
                        if (modelDir != null && (modelDir.exists() || modelDir.mkdirs())) {
                            Log.i(TAG, "Importing model into internal storage: " + cand.getAbsolutePath() + " -> " + primary.getAbsolutePath());
                            java.io.FileInputStream in = new java.io.FileInputStream(cand);
                            java.io.FileOutputStream out = new java.io.FileOutputStream(primary);
                            byte[] buf = new byte[2 * 1024 * 1024];
                            int r;
                            while ((r = in.read(buf)) > 0) {
                                out.write(buf, 0, r);
                            }
                            in.close();
                            out.close();
                            if (primary.exists() && primary.length() >= MIN_MODEL_BYTES) {
                                Log.i(TAG, "Model successfully copied to internal storage: " + primary.length() + " bytes");
                                return primary;
                            }
                        }
                        return cand;
                    }
                } catch (Throwable ignored) {}
            }
        } catch (Throwable ignored) {}
        return primary;
    }

    public LocalNeuralEngine(String modelId, File modelDir) {
        this.modelId = modelId;
        this.modelFile = resolveModelFile(modelDir, modelId);
    }

    private static String modelKey(File file) {
        return file.getAbsolutePath() + "|" + file.length() + "|" + file.lastModified();
    }

    /**
     * Validates the header of a GGUF file before the native engine sees it.
     *
     * A download that stopped in the middle leaves a file with a correct
     * magic but truncated tensor tables, llama.cpp fails inside the native
     * code and the whole process of the application dies. The header check
     * answers with a Java error instead, the file is downloaded again.
     *
     * @return null when the header is sane, the reason text when it is not
     */
    public static String validateGgufHeader(File file) {
        if (file == null || !file.exists()) {
            return "the model file does not exist";
        }
        long length = file.length();
        if (length < MIN_MODEL_BYTES) {
            return "the model file is too small: " + length + " bytes";
        }
        java.io.RandomAccessFile raf = null;
        try {
            raf = new java.io.RandomAccessFile(file, "r");
            byte[] magic = new byte[4];
            raf.readFully(magic);
            if (magic[0] != 'G' || magic[1] != 'G' || magic[2] != 'U' || magic[3] != 'F') {
                return "the model file is not a GGUF file";
            }
            // version, tensor count and metadata kv count, little endian
            int version = readIntLE(raf);
            if (version != 1 && version != 2 && version != 3) {
                return "the GGUF version " + version + " is not supported";
            }
            long tensorCount;
            long kvCount;
            if (version == 1) {
                tensorCount = readIntLE(raf) & 0xFFFFFFFFL;
                kvCount = readIntLE(raf) & 0xFFFFFFFFL;
            } else {
                tensorCount = readLongLE(raf);
                kvCount = readLongLE(raf);
            }
            if (tensorCount <= 0 || tensorCount > 1000000) {
                return "the GGUF tensor count " + tensorCount + " is not sane";
            }
            if (kvCount < 0 || kvCount > 1000000) {
                return "the GGUF metadata count " + kvCount + " is not sane";
            }
            return null;
        } catch (Throwable t) {
            return "the GGUF header could not be read: " + (t.getMessage() != null ? t.getMessage() : t.toString());
        } finally {
            if (raf != null) {
                try {
                    raf.close();
                } catch (Throwable ignored) {}
            }
        }
    }

    private static int readIntLE(java.io.RandomAccessFile raf) throws java.io.IOException {
        int b0 = raf.read();
        int b1 = raf.read();
        int b2 = raf.read();
        int b3 = raf.read();
        if ((b0 | b1 | b2 | b3) < 0) {
            throw new java.io.EOFException("the model file is truncated");
        }
        return (b3 << 24) | (b2 << 16) | (b1 << 8) | b0;
    }

    private static long readLongLE(java.io.RandomAccessFile raf) throws java.io.IOException {
        long low = readIntLE(raf) & 0xFFFFFFFFL;
        long high = readIntLE(raf) & 0xFFFFFFFFL;
        return (high << 32) | low;
    }

    /**
     * The context of the model follows the memory of the device. A small context keeps
     * the device responsive, a large one gives the model more room for long answers.
     */
    private static int contextSizeForDevice() {
        Runtime runtime = Runtime.getRuntime();
        long available = runtime.maxMemory();
        if (available <= 0) {
            available = 2L * 1024 * 1024 * 1024;
        }
        long megabytes = available / (1024 * 1024);
        if (megabytes >= 6144) {
            return 8192;
        }
        if (megabytes >= 3072) {
            return 4096;
        }
        return 2048;
    }

    /**
     * Loads (and caches) the llama.cpp model. The caller must surface any failure to
     * the server instead of substituting generated content.
     */
    private static LlamaModel acquireModel(File file) throws Exception {
        String key = modelKey(file);
        synchronized (MODEL_LOCK) {
            if (cachedModel != null && key.equals(cachedModelKey)) {
                return cachedModel;
            }
            if (cachedModel != null) {
                try {
                    cachedModel.close();
                } catch (Throwable ignored) {
                }
                cachedModel = null;
                cachedModelKey = null;
            }

            // Single thread ensures 100% stability under ARM translation without OpenMP futex issues
            int threads = 1;

            ModelParameters params = new ModelParameters()
                    .setModel(file.getAbsolutePath())
                    .setThreads(threads)
                    .setThreadsBatch(threads)
                    .setCtxSize(1024)
                    .setBatchSize(128)
                    .setGpuLayers(0)
                    .skipWarmup()
                    .disablePerf();

            LlamaModel model = new LlamaModel(params);
            cachedModel = model;
            cachedModelKey = key;
            return model;
        }
    }

    /** Releases the cached model (used when the worker purges or swaps models). */
    public static void releaseModel() {
        synchronized (MODEL_LOCK) {
            if (cachedModel != null) {
                try {
                    cachedModel.close();
                } catch (Throwable ignored) {
                }
            }
            cachedModel = null;
            cachedModelKey = null;
        }
    }

    /**
     * Builds the inference parameters. The GGUF chat template is applied by llama.cpp
     * itself (use_jinja), so prompts are formatted correctly for the concrete model
     * family instead of relying on a hard coded template.
     */
    private InferenceParameters buildParameters(String prompt, int maxTokens, float temperature, float topP, String[] stop) {
        String formatted;
        if (modelId != null && modelId.toLowerCase().contains("qwen")) {
            formatted = "<|im_start|>system\nYou are a helpful AI assistant. Always respond concisely in the user's language.<|im_end|>\n<|im_start|>user\n" + prompt + "<|im_end|>\n<|im_start|>assistant\n";
        } else {
            formatted = prompt;
        }

        InferenceParameters params = new InferenceParameters(formatted);
        params.setNPredict(maxTokens > 0 ? maxTokens : 64);
        params.setTemperature(temperature > 0 ? temperature : 0.7f);
        params.setTopP(topP > 0 ? topP : 0.92f);
        params.setRepeatPenalty(1.1f);

        List<String> stopList = new ArrayList<>();
        stopList.add("<|im_end|>");
        stopList.add("<|endoftext|>");
        if (stop != null) {
            for (String s : stop) {
                if (s != null && !s.isEmpty()) stopList.add(s);
            }
        }
        params.setStopStrings(stopList.toArray(new String[0]));
        return params;
    }

    /** Fallback parameters for GGUF files that do not ship a usable chat template. */
    private InferenceParameters buildRawParameters(String prompt, int maxTokens, float temperature, float topP) {
        InferenceParameters params = new InferenceParameters(prompt);
        params.setNPredict(maxTokens);
        params.setTemperature(temperature);
        params.setTopP(topP > 0 ? topP : 0.92f);
        params.setRepeatPenalty(1.08f);
        return params;
    }

    /**
     * Streams the tokens produced by llama.cpp into the callback.
     *
     * @return true when the caller asked to stop the generation
     */
    private boolean streamTokens(LlamaModel model, InferenceParameters params, StreamCallback callback, GenerationState state) {
        for (LlamaOutput out : model.generate(params)) {
            String piece = out.text;
            if (piece == null || piece.isEmpty()) {
                continue;
            }
            if (state.firstTokenAt == 0) {
                state.firstTokenAt = System.currentTimeMillis();
            }
            state.text.append(piece);
            state.tokenCount++;

            if (out.probabilities != null) {
                try {
                    for (java.util.Map.Entry<String, Float> entry : out.probabilities.entrySet()) {
                        Float p = entry.getValue();
                        if (p != null && p > 0f) {
                            state.logprobs.add((float) Math.log(p.doubleValue()));
                        }
                    }
                } catch (Throwable ignored) {
                }
            }

            if (callback != null) {
                boolean cont;
                try {
                    cont = callback.onToken(piece, 1000 + state.tokenCount);
                } catch (Throwable ignored) {
                    cont = false;
                }
                if (!cont) {
                    return true;
                }
            }
        }
        return false;
    }

    /**
     * Runs a real llama.cpp generation pass and streams the produced tokens.
     */
    public InferenceResult generateStream(String prompt, int maxTokens, float temperature, float topP, String[] stop, StreamCallback callback) {
        InferenceResult res = new InferenceResult();
        long startTime = System.currentTimeMillis();

        if (maxTokens <= 0) {
            maxTokens = 512;
        }
        if (maxTokens > MAX_TOKENS_LIMIT) {
            maxTokens = MAX_TOKENS_LIMIT;
        }
        if (temperature <= 0.01f) {
            temperature = 0.7f;
        }

        if (modelFile == null || !modelFile.exists() || modelFile.length() < MIN_MODEL_BYTES) {
            res.error = "Model dosyası bulunamadı veya eksik: " + (modelFile != null ? modelFile.getName() : "model.gguf");
            res.success = false;
            res.ttftMs = 0;
            res.tps = 0.0f;
            return res;
        }

        // The header of the file is checked in Java before the native engine
        // sees it. A truncated download ends the whole process inside
        // llama.cpp, the check here answers with the error of the result and
        // the corrupted file is dropped for a fresh download.
        String headerProblem = validateGgufHeader(modelFile);
        if (headerProblem != null) {
            Log.e(TAG, "model header rejected: " + headerProblem);
            try {
                if (!modelFile.delete()) {
                    Log.w(TAG, "the corrupted model file could not be deleted: " + modelFile.getAbsolutePath());
                }
            } catch (Throwable ignored) {}
            res.error = "Model dosyası bozuk, yeniden indirilecek: " + headerProblem;
            res.success = false;
            res.ttftMs = 0;
            res.tps = 0.0f;
            return res;
        }

        GenerationState state = new GenerationState();

        // Every generation of the device runs inside the same lock, the
        // native engine is not safe for two concurrent generations.
        synchronized (INFERENCE_LOCK) {
            try {
                if (System.getProperty("de.kherud.llama.lib.path") != null) {
                    File nativeLib = new File(System.getProperty("de.kherud.llama.lib.path"), "libjllama.so");
                    if (nativeLib.exists()) {
                        try {
                            System.load(nativeLib.getAbsolutePath());
                        } catch (Throwable ignored) {}
                    }
                }
                try {
                    System.loadLibrary("jllama");
                } catch (Throwable ignored) {}
                LlamaModel model = acquireModel(modelFile);

                try {
                    res.promptTokens = model.encode(prompt).length;
                } catch (Throwable ignored) {
                    res.promptTokens = Math.max(1, prompt.length() / 4);
                }

                try {
                    streamTokens(model, buildParameters(prompt, maxTokens, temperature, topP, stop), callback, state);
                } catch (Throwable templateFailure) {
                    // GGUF without a usable chat template: retry once with the raw prompt.
                    Log.w(TAG, "chat template generation failed, retrying with raw prompt: " + templateFailure.getMessage());
                    state.tokenCount = 0;
                    state.firstTokenAt = 0;
                    state.text.setLength(0);
                    state.logprobs.clear();
                    streamTokens(model, buildRawParameters(prompt, maxTokens, temperature, topP), callback, state);
                }

                res.success = true;
            } catch (Throwable t) {
                String msg = t.getMessage() != null ? t.getMessage() : t.toString();
                Log.e(TAG, "llama.cpp inference failed: " + msg, t);
                res.error = "Cihazda yerel model çalıştırılamadı: " + msg;
                res.success = false;
                if (state.tokenCount == 0) {
                    state.text.setLength(0);
                }
            }
        }

        long endTime = System.currentTimeMillis();
        res.ttftMs = (int) (state.firstTokenAt > 0 ? (state.firstTokenAt - startTime) : (endTime - startTime));
        if (res.ttftMs < 0) {
            res.ttftMs = 0;
        }

        long generationMs = state.firstTokenAt > 0 ? (endTime - state.firstTokenAt) : 0;
        if (generationMs <= 0) {
            generationMs = Math.max(1, endTime - startTime);
        }
        if (state.tokenCount > 0) {
            res.tps = (float) ((state.tokenCount * 1000.0) / generationMs);
        } else {
            res.tps = 0.0f;
        }
        res.tps = Math.round(res.tps * 10.0f) / 10.0f;
        res.totalTokens = state.tokenCount;
        res.fullText = state.text.toString().trim();
        res.logprobs.addAll(state.logprobs);
        return res;
    }
}
